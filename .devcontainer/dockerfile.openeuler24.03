# Use the openEuler 24.03 LTS base image
FROM openeuler/openeuler:24.03-lts

# Install development dependencies from the repositories provided by openEuler
RUN dnf makecache && \
    dnf install -y curl git tar clang libacl-devel libselinux-devel && \
    dnf clean all && \
    rm -rf /var/cache/dnf

# Configure the Rust toolchain mirror
ENV RUSTUP_DIST_SERVER=https://rsproxy.cn \
    RUSTUP_UPDATE_ROOT=https://rsproxy.cn/rustup

# Install Rust from the mirror
RUN curl --proto '=https' --tlsv1.2 -sSf https://rsproxy.cn/rustup-init.sh | sh -s -- -y

# Add Cargo to PATH
ENV PATH="/root/.cargo/bin:${PATH}"

# Configure the Cargo registry mirror
RUN mkdir -p /root/.cargo && \
    echo -e '[registry]\n\
[source.crates-io]\n\
replace-with = "rsproxy-sparse"\n\
[source.rsproxy]\n\
registry = "https://rsproxy.cn/crates.io-index"\n\
[source.rsproxy-sparse]\n\
registry = "sparse+https://rsproxy.cn/index/"\n\
[registries.rsproxy]\n\
index = "https://rsproxy.cn/crates.io-index"\n\
[net]\n\
git-fetch-with-cli = true' > /root/.cargo/config.toml

# Verify the Rust installation
RUN rustup --version && cargo --version

WORKDIR /home
