    {
      "command": "chmod",
      "description": "chmod: -R 递归修改目录和文件",
      "args": [
        "-R",
        "755",
        "test_dir_rec"
      ],
      "setup_commands": [
        "mkdir -p test_dir_rec/subdir",
        "touch test_dir_rec/file1 test_dir_rec/subdir/file2",
        "chmod -R 600 test_dir_rec"
      ],
      "expectation": {
        "execution": {
          "exit_code": 0,
          "stdout": "",
          "stderr": ""
        },
        "verifications": [
          {
            "command": "stat -c '%a' test_dir_rec",
            "expected_exit": 0,
            "expected_stdout": "755\n"
          },
          {
            "command": "stat -c '%a' test_dir_rec/file1",
            "expected_exit": 0,
            "expected_stdout": "755\n"
          },
          {
            "command": "stat -c '%a' test_dir_rec/subdir",
            "expected_exit": 0,
            "expected_stdout": "755\n"
          },
          {
            "command": "stat -c '%a' test_dir_rec/subdir/file2",
            "expected_exit": 0,
            "expected_stdout": "755\n"
          }
        ],
        "ignore_fields": {
          "ignore_exit_code": false,
          "ignore_stdout": false,
          "ignore_stderr": false,
          "ignore_function": false
        }
      },
      "cleanup_commands": [
        "rm -rf test_dir_rec"
      ],
      "requires_root": false,
      "timeout": 30
    }
  ]
