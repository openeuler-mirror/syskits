{
  "tests": [
    {
      "command": "chmod",
      "description": "chmod: 八进制模式修改单个文件",
      "args": [
        "755",
        "test_file_octal_single"
      ],
      "setup_commands": [
        "touch test_file_octal_single",
        "chmod 600 test_file_octal_single"
      ],
      "expectation": {
        "execution": {
          "exit_code": 0,
          "stdout": "",
          "stderr": ""
        },
        "verifications": [
          {
            "command": "stat -c '%a' test_file_octal_single",
            "expected_exit": 0,
            "expected_stdout": "755\n"
          }
        ],
        "ignore_fields": {
          "ignore_exit_code": false,
          "ignore_stdout": false,
          "ignore_stderr": false,
          "ignore_function": false
        }
      },
      "cleanup_commands": [
        "rm -f test_file_octal_single"
      ],
      "requires_root": false,
      "timeout": 30
    },
