{
  "tests": [
    {
      "command": "chmod",
      "description": "chmod: 八进制模式修改单个文件",
      "args": [
        "755",
        "test_file_octal_single"
      ],
      "setup_commands": [
        "touch test_file_octal_single",
        "chmod 600 test_file_octal_single"
      ],
      "expectation": {
        "execution": {
          "exit_code": 0,
          "stdout": "",
          "stderr": ""
        },
        "verifications": [
          {
            "command": "stat -c '%a' test_file_octal_single",
            "expected_exit": 0,
            "expected_stdout": "755\n"
          }
        ],
        "ignore_fields": {
          "ignore_exit_code": false,
          "ignore_stdout": false,
          "ignore_stderr": false,
          "ignore_function": false
        }
      },
      "cleanup_commands": [
        "rm -f test_file_octal_single"
      ],
      "requires_root": false,
      "timeout": 30
    },
    {
      "command": "chmod",
      "description": "chmod: 八进制模式修改多个文件",
      "args": [
        "644",
        "file1_octal.txt",
        "file2_octal.txt"
      ],
      "setup_commands": [
        "touch file1_octal.txt file2_octal.txt",
        "chmod 600 file1_octal.txt file2_octal.txt"
      ],
      "expectation": {
        "execution": {
          "exit_code": 0,
          "stdout": "",
          "stderr": ""
        },
        "verifications": [
          {
            "command": "stat -c '%a' file1_octal.txt",
            "expected_exit": 0,
            "expected_stdout": "644\n"
          },
          {
            "command": "stat -c '%a' file2_octal.txt",
            "expected_exit": 0,
            "expected_stdout": "644\n"
          }
        ],
        "ignore_fields": {
          "ignore_exit_code": false,
          "ignore_stdout": false,
          "ignore_stderr": false,
          "ignore_function": false
        }
      },
      "cleanup_commands": [
        "rm -f file1_octal.txt file2_octal.txt"
      ],
      "requires_root": false,
      "timeout": 30
    },
