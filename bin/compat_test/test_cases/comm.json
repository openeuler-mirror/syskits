{
    "tests": [
        {
            "command": "comm",
            "description": "comm: 基础功能 - 比较两个排序文件（默认输出3列）",
            "args": [
                "file1.txt",
                "file2.txt"
            ],
            "setup_commands": [
                "echo -e 'a\\nb\\nc' > file1.txt",
                "echo -e 'b\\nc\\nd' > file2.txt"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "a\n\t\tb\n\t\tc\n\t\td\n",
                    "stderr": ""
                },
                "verifications": [],
                "ignore_fields": {
                    "ignore_exit_code": false,
                    "ignore_stdout": false,
                    "ignore_stderr": true,
                    "ignore_function": false
                }
            },
            "cleanup_commands": [
                "rm -f file1.txt file2.txt"
            ],
            "requires_root": false,
            "timeout": 30
        },
        {
            "command": "comm",
            "description": "comm: -1 - 不输出第一列（仅在文件1独有的行）",
