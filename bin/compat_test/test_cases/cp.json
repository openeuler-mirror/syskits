{
    "tests": [
        {
            "command": "cp",
            "description": "cp --help",
            "args": [
                "--help"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "ignore_fields": {
                    "ignore_stdout": true,
                    "ignore_stderr": true
                }
            }
        },
        {
            "command": "cp",
            "description": "cp --version",
            "args": [
                "--version"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "ignore_fields": {
                    "ignore_stdout": true,
                    "ignore_stderr": true
                }
            }
        },
        {
            "command": "cp",
            "description": "Basic file copy",
            "args": [
                "f1",
                "f2"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "test -f f2",
                        "expected_exit": 0
                    }
                ]
            },
            "setup_commands": [
                "touch f1"
            ],
            "cleanup_commands": [
                "rm -f f1 f2"
            ]
        },
        {
            "command": "cp",
            "description": "Copy multiple files to directory",
            "args": [
                "f1",
                "f2",
                "d1"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "test -f d1/f1 -a -f d1/f2",
                        "expected_exit": 0
                    }
                ]
            },
            "setup_commands": [
                "touch f1 f2",
                "mkdir d1"
            ],
            "cleanup_commands": [
                "rm -rf f1 f2 d1"
            ]
        },
        {
            "command": "cp",
            "description": "Archive mode (-a)",
            "args": [
                "-a",
                "d1",
                "d2"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "test -d d2 -a -f d2/f1",
                        "expected_exit": 0
                    }
                ]
            },
            "setup_commands": [
                "mkdir d1",
                "touch d1/f1"
            ],
            "cleanup_commands": [
                "rm -rf d1 d2"
            ]
        },
        {
            "command": "cp",
            "description": "Attributes only",
            "args": [
                "--attributes-only",
                "f1",
                "f2"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "test ! -s f2",
                        "expected_exit": 0
                    }
                ]
            },
            "setup_commands": [
                "echo hello > f1"
            ],
            "cleanup_commands": [
                "rm -f f1 f2"
            ]
        },
        {
            "command": "cp",
            "description": "Backup existing file (-b)",
            "args": [
                "-b",
                "f1",
                "f2"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "test -f f2~",
                        "expected_exit": 0
                    }
                ]
            },
            "setup_commands": [
                "touch f1",
                "touch f2"
            ],
            "cleanup_commands": [
                "rm -f f1 f2 f2~"
            ]
        },
        {
            "command": "cp",
            "description": "Backup existing file (--backup=numbered)",
            "args": [
                "--backup=numbered",
                "f1",
                "f2"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "test -f f2.~1~",
                        "expected_exit": 0
                    }
                ]
            },
            "setup_commands": [
                "touch f1",
                "touch f2"
            ],
            "cleanup_commands": [
                "rm -f f1 f2 f2.~1~"
            ]
        },
        {
            "command": "cp",
            "description": "Backup suffix (-S)",
            "args": [
                "-b",
                "-S",
                ".bak",
                "f1",
                "f2"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "test -f f2.bak",
                        "expected_exit": 0
                    }
                ]
            },
            "setup_commands": [
                "touch f1",
                "touch f2"
            ],
            "cleanup_commands": [
                "rm -f f1 f2 f2.bak"
            ]
        },
        {
            "command": "cp",
            "description": "Copy contents of special file (--copy-contents)",
            "args": [
                "-r",
                "--copy-contents",
                "d1",
                "d2"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                }
            },
            "setup_commands": [
                "mkdir d1",
                "touch d1/fifo"
            ],
            "cleanup_commands": [
                "rm -rf d1 d2"
            ]
        },
        {
            "command": "cp",
            "description": "Basic recursive copy (-r)",
            "args": [
                "-r",
                "d1",
                "d2"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "test -f d2/f1",
                        "expected_exit": 0
                    }
                ]
            },
            "setup_commands": [
                "mkdir d1",
                "echo data > d1/f1"
            ],
            "cleanup_commands": [
                "rm -rf d1 d2"
            ]
        },
        {
            "command": "cp",
            "description": "Copy symlink (-d)",
            "args": [
                "-d",
                "l1",
                "l2"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "test -h l2",
                        "expected_exit": 0
                    }
                ]
            },
            "setup_commands": [
                "touch f1",
                "ln -s f1 l1"
            ],
            "cleanup_commands": [
                "rm -f f1 l1 l2"
            ]
        },
        {
            "command": "cp",
            "description": "Debug and verbose",
            "args": [
                "--debug",
                "-v",
                "f1",
                "f2"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "'f1' -> 'f2'\ncopy offload: unknown, reflink: unsupported, sparse detection: no\n",
                    "stderr": ""
                }
            },
            "setup_commands": [
                "touch f1"
            ],
            "cleanup_commands": [
                "rm -f f1 f2"
            ]
        },
        {
            "command": "cp",
            "description": "Force overwrite (-f)",
            "args": [
                "-f",
                "f1",
                "f2"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "test -f f2",
                        "expected_exit": 0
                    }
                ]
            },
            "setup_commands": [
                "touch f1",
                "touch f2",
                "chmod 000 f2"
            ],
            "cleanup_commands": [
                "rm -f f1 f2"
            ]
        },
        {
            "command": "cp",
            "description": "No clobber (-n)",
            "args": [
                "-n",
                "f1",
                "f2"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "cp: 不替换 'f2'\n"
                },
                "verifications": [
                    {
                        "command": "grep -q B f2",
                        "expected_exit": 0
                    }
                ]
            },
            "setup_commands": [
                "echo A > f1",
                "echo B > f2"
            ],
            "cleanup_commands": [
                "rm -f f1 f2"
            ]
        },
        {
            "command": "cp",
            "description": "Follow cmdline symlink (-H)",
            "args": [
                "-H",
                "-r",
                "l1",
                "d2"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "test -f d2/f1",
                        "expected_exit": 0
                    }
                ]
            },
            "setup_commands": [
                "mkdir d1",
                "touch d1/f1",
                "ln -s d1 l1"
            ],
            "cleanup_commands": [
                "rm -rf d1 l1 d2"
            ]
        },
        {
            "command": "cp",
            "description": "Dereference symlinks (-L) recursive",
            "args": [
                "-L",
                "-r",
                "d1",
                "d2"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "test ! -h d2/l1",
                        "expected_exit": 0
                    }
                ]
            },
            "setup_commands": [
                "mkdir d1",
                "echo data > f1",
                "ln -s ../f1 d1/l1"
            ],
            "cleanup_commands": [
                "rm -rf d1 d2 f1"
            ]
        },
        {
            "command": "cp",
            "description": "No dereference symlinks (-P) recursive",
            "args": [
                "-P",
                "-r",
                "d1",
                "d2"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "test -h d2/l1",
                        "expected_exit": 0
                    }
                ]
            },
            "setup_commands": [
                "mkdir d1",
                "echo data > f1",
                "ln -s ../f1 d1/l1"
            ],
            "cleanup_commands": [
                "rm -rf d1 d2 f1"
            ]
        },
        {
            "command": "cp",
            "description": "Create hard link (-l)",
            "args": [
                "-l",
                "f1",
                "f2"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "test $(stat -c %i f1) = $(stat -c %i f2)",
                        "expected_exit": 0
                    }
                ]
            },
            "setup_commands": [
                "touch f1"
            ],
            "cleanup_commands": [
                "rm -f f1 f2"
            ]
        },
        {
            "command": "cp",
            "description": "Create soft link (-s)",
            "args": [
                "-s",
                "f1",
                "l1"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "test -h l1",
                        "expected_exit": 0
                    }
                ]
            },
            "setup_commands": [
                "touch f1"
            ],
            "cleanup_commands": [
                "rm -f f1 l1"
            ]
        },
        {
            "command": "cp",
            "description": "Preserve attributes (-p)",
            "args": [
                "-p",
                "f1",
                "f2"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "test \"$(stat -c %a f1)\" = \"$(stat -c %a f2)\"",
                        "expected_exit": 0
                    }
                ]
            },
            "setup_commands": [
                "touch f1",
                "chmod 777 f1"
            ],
            "cleanup_commands": [
                "rm -f f1 f2"
            ]
        },
        {
            "command": "cp",
            "description": "Preserve specific attributes (--preserve=timestamps)",
            "args": [
                "--preserve=timestamps",
                "f1",
                "f2"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "test \"$(stat -c %Y f1)\" = \"$(stat -c %Y f2)\"",
                        "expected_exit": 0
                    }
                ]
            },
            "setup_commands": [
                "touch -d '2000-01-01 00:00:00' f1",
                "sleep 1"
            ],
            "cleanup_commands": [
                "rm -f f1 f2"
            ]
        },
        {
            "command": "cp",
            "description": "No preserve (--no-preserve=mode)",
            "args": [
                "--no-preserve=mode",
                "f1",
                "f2"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                }
            },
            "setup_commands": [
                "touch f1",
                "chmod 777 f1",
                "umask 022"
            ],
            "cleanup_commands": [
                "rm -f f1 f2"
            ]
        },
        {
            "command": "cp",
            "description": "Use full source directories (--parents)",
            "args": [
                "--parents",
                "d1/f1",
                "d2"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "test -f d2/d1/f1",
                        "expected_exit": 0
                    }
                ]
            },
            "setup_commands": [
                "mkdir -p d1 d2",
                "touch d1/f1"
            ],
            "cleanup_commands": [
                "rm -rf d1 d2"
            ]
        },
        {
            "command": "cp",
            "description": "Target directory (-t)",
            "args": [
                "-t",
                "d1",
                "f1",
                "f2"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "test -f d1/f1 -a -f d1/f2",
                        "expected_exit": 0
                    }
                ]
            },
            "setup_commands": [
                "mkdir d1",
                "touch f1 f2"
            ],
            "cleanup_commands": [
                "rm -rf d1 f1 f2"
            ]
        },
        {
            "command": "cp",
            "description": "No target directory (-T)",
            "args": [
                "-T",
                "f1",
                "f2"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "test -f f2",
                        "expected_exit": 0
                    }
                ]
            },
            "setup_commands": [
                "touch f1"
            ],
            "cleanup_commands": [
                "rm -f f1 f2"
            ]
        },
        {
            "command": "cp",
            "description": "Update older (--update)",
            "args": [
                "--update",
                "f1",
                "f2"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "grep -q NEW f2",
                        "expected_exit": 0
                    }
                ]
            },
            "setup_commands": [
                "echo OLD > f2",
                "echo NEW > f1",
                "touch -d '2000-01-01' f2"
            ],
            "cleanup_commands": [
                "rm -f f1 f2"
            ]
        },
        {
            "command": "cp",
            "description": "Update older skipped (--update)",
            "args": [
                "--update",
                "f1",
                "f2"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "grep -q NEW f2",
                        "expected_exit": 0
                    }
                ]
            },
            "setup_commands": [
                "echo NEW > f2",
                "echo OLD > f1",
                "touch -d '2000-01-01' f1"
            ],
            "cleanup_commands": [
                "rm -f f1 f2"
            ]
        },
        {
            "command": "cp",
            "description": "One file system (-x)",
            "args": [
                "-x",
                "-r",
                "d1",
                "d2"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "test -f d2/f1",
                        "expected_exit": 0
                    }
                ]
            },
            "setup_commands": [
                "mkdir d1",
                "touch d1/f1"
            ],
            "cleanup_commands": [
                "rm -rf d1 d2"
            ]
        },
        {
            "command": "cp",
            "description": "Remove destination (--remove-destination)",
            "args": [
                "--remove-destination",
                "f1",
                "f2"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "test -f f2",
                        "expected_exit": 0
                    }
                ]
            },
            "setup_commands": [
                "touch f1 f2",
                "chmod 0 f2"
            ],
            "cleanup_commands": [
                "rm -f f1 f2"
            ]
        }
    ]
}