            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                }
            },
            "cleanup_commands": [],
            "tstdin": ""
        },
        {
            "command": "env",
            "description": "信号列表逗号后的空白属于信号操作数；执行env --block-signal=HUP, INT /usr/bin/true；预期RC=125且stdout为空，stderr措辞由各实现独立维护",
            "args": [
