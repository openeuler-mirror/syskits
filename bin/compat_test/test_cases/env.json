        {
            "command": "env",
            "description": "GNU env通过execvp替换自身；子进程的父进程不应仍为syskits，预期Python检测到父进程名非syskits并以0退出",
            "args": [
                "/usr/bin/python3",
                "-c",
                "import os, sys; sys.exit(open(f'/proc/{os.getppid()}/comm').read().strip() == 'syskits')"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                }
            }
        },
        {
            "command": "env",
            "description": "Test command not found (exit 127)",
            "args": ["nonexistent_command_12345"],
            "expectation": {
                "execution": {
                    "exit_code": 127,
                    "stdout": "",
                    "stderr": null
                }
            }
        },
        {
            "command": "env",
            "description": "Test command not executable (exit 126)",
            "args": ["./nonexec_file"],
            "setup_commands": ["touch nonexec_file", "chmod -x nonexec_file"],
            "expectation": {
                "execution": {
                    "exit_code": 126,
                    "stdout": "",
                    "stderr": null
                },
                "verifications": [
                    {
                        "command": "echo \"$CMD_STDERR\" | grep -q -i 'permission denied'",
                        "expected_exit": 0
                    }
                ]
            },
            "cleanup_commands": ["rm -f nonexec_file"]
        },
        {
            "command": "env",
