{
    "tests": [
        {
            "command": "env",
            "description": "Basic env with no arguments - print environment",
            "args": [],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": null,
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "test -n \"$CMD_STDOUT\"",
                        "expected_exit": 0
                    }
                ]
            }
        },
        {
            "command": "env",
            "description": "Clear environment with -i",
            "args": ["-i"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                }
            }
        },
        {
            "command": "env",
            "description": "Clear environment with --ignore-environment",
            "args": ["--ignore-environment"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                }
            }
        },
        {
            "command": "env",
            "description": "-i清空环境后不再校验-u的无效变量名；执行env -i -u A=B /usr/bin/true；预期RC=0，stdout和stderr均为空",
            "args": ["-i", "-u", "A=B", "/usr/bin/true"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                }
            }
        },
        {
            "command": "env",
            "description": "Clear environment with - (dash)",
            "args": ["-"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                }
            }
        },
        {
            "command": "env",
            "description": "仅第一个非选项-清空环境；执行env - -；第二个-作为COMMAND，预期RC=127且stdout为空",
            "args": ["-", "-"],
            "expectation": {
                "execution": {
                    "exit_code": 127,
                    "stdout": "",
                    "stderr": null
                }
            }
        },
        {
            "command": "env",
            "description": "重复-i和-0按幂等方式解析；执行env -i -i -0 -0 A=B；预期RC=0，stdout为A=B加NUL，stderr为空",
            "args": ["-i", "-i", "-0", "-0", "A=B"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "A=B\u0000",
                    "stderr": ""
                }
            }
        },
        {
            "command": "env",
            "description": "重复-C采用最后一个目录；执行env -C / -C /tmp /usr/bin/pwd；预期RC=0，stdout为/tmp加换行，stderr为空",
            "args": ["-C", "/", "-C", "/tmp", "/usr/bin/pwd"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "/tmp\n",
                    "stderr": ""
                }
            }
        },
        {
            "command": "env",
            "description": "Set environment variable",
            "args": ["-i", "TEST_VAR=test_value"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "TEST_VAR=test_value\n",
                    "stderr": ""
                }
            }
        },
        {
            "command": "env",
            "description": "空NAME赋值按GNU putenv语义保留原始环境项；执行env -i =value；预期RC=0，stdout为=value加换行，stderr为空",
            "args": ["-i", "=value"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "=value\n",
                    "stderr": ""
                }
            }
        },
        {
            "command": "env",
            "description": "Set multiple environment variables",
            "args": ["-i", "VAR1=value1", "VAR2=value2"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": null,
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "echo \"$CMD_STDOUT\" | grep -q 'VAR1=value1'",
                        "expected_exit": 0
                    },
                    {
                        "command": "echo \"$CMD_STDOUT\" | grep -q 'VAR2=value2'",
                        "expected_exit": 0
                    }
                ]
            }
        },
        {
            "command": "env",
            "description": "Unset environment variable with -u",
            "setup_commands": ["export TEST_UNSET=value"],
            "args": ["-u", "TEST_UNSET"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": null,
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "echo \"$CMD_STDOUT\" | grep -q 'TEST_UNSET' && exit 1 || exit 0",
                        "expected_exit": 0
                    }
                ]
            },
            "cleanup_commands": ["unset TEST_UNSET"]
        },
        {
            "command": "env",
            "description": "Multiple -u options to unset multiple variables",
            "setup_commands": ["export VAR_A=a", "export VAR_B=b"],
            "args": ["-u", "VAR_A", "-u", "VAR_B"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": null,
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "echo \"$CMD_STDOUT\" | grep -q 'VAR_A' && exit 1 || exit 0",
                        "expected_exit": 0
                    },
                    {
                        "command": "echo \"$CMD_STDOUT\" | grep -q 'VAR_B' && exit 1 || exit 0",
                        "expected_exit": 0
                    }
                ]
            },
            "cleanup_commands": ["unset VAR_A VAR_B"]
        },
        {
            "command": "env",
            "description": "Execute simple command",
            "args": ["echo", "hello"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "hello\n",
                    "stderr": ""
                }
            }
        },
        {
            "command": "env",
            "description": "Execute command with environment variable",
            "args": ["-i", "TEST_VAR=test", "sh", "-c", "echo $TEST_VAR"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "test\n",
                    "stderr": ""
                }
            }
        },
        {
            "command": "env",
            "description": "Set variable and execute shell command",
            "args": ["FOO=bar", "sh", "-c", "echo $FOO"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "bar\n",
                    "stderr": ""
                }
            }
        },
        {
            "command": "env",
            "description": "Test exit code propagation (exit 0)",
            "args": ["sh", "-c", "exit 0"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                }
            }
        },
        {
            "command": "env",
            "description": "Test exit code propagation (exit 1)",
            "args": ["sh", "-c", "exit 1"],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": ""
                }
            }
        },
        {
            "command": "env",
            "description": "Test exit code propagation (exit 2)",
            "args": ["sh", "-c", "exit 2"],
            "expectation": {
                "execution": {
                    "exit_code": 2,
                    "stdout": "",
                    "stderr": ""
                }
            }
        },
        {
            "command": "env",
            "description": "Test exit code propagation (exit 125)",
            "args": ["sh", "-c", "exit 125"],
            "expectation": {
                "execution": {
                    "exit_code": 125,
                    "stdout": "",
                    "stderr": ""
                }
            }
        },
        {
            "command": "env",
            "description": "GNU env通过execvp替换自身；子进程的父进程不应仍为syskits，预期Python检测到父进程名非syskits并以0退出",
            "args": [
                "/usr/bin/python3",
                "-c",
                "import os, sys; sys.exit(open(f'/proc/{os.getppid()}/comm').read().strip() == 'syskits')"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                }
            }
        },
        {
            "command": "env",
            "description": "Test command not found (exit 127)",
            "args": ["nonexistent_command_12345"],
            "expectation": {
                "execution": {
                    "exit_code": 127,
                    "stdout": "",
                    "stderr": null
                }
            }
        },
        {
            "command": "env",
            "description": "Test command not executable (exit 126)",
            "args": ["./nonexec_file"],
            "setup_commands": ["touch nonexec_file", "chmod -x nonexec_file"],
            "expectation": {
                "execution": {
                    "exit_code": 126,
                    "stdout": "",
                    "stderr": null
                },
                "verifications": [
                    {
                        "command": "echo \"$CMD_STDERR\" | grep -q -i 'permission denied'",
                        "expected_exit": 0
                    }
                ]
            },
            "cleanup_commands": ["rm -f nonexec_file"]
        },
        {
            "command": "env",
            "description": "Test --chdir option",
            "setup_commands": ["mkdir -p /tmp/test_env_chdir"],
            "args": ["--chdir=/tmp/test_env_chdir", "pwd"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "/tmp/test_env_chdir\n",
                    "stderr": ""
                }
            },
            "cleanup_commands": ["rm -rf /tmp/test_env_chdir"]
        },
        {
            "command": "env",
            "description": "Test -C option (short form)",
            "setup_commands": ["mkdir -p /tmp/test_env_chdir2"],
            "args": ["-C", "/tmp/test_env_chdir2", "pwd"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "/tmp/test_env_chdir2\n",
                    "stderr": ""
                }
            },
            "cleanup_commands": ["rm -rf /tmp/test_env_chdir2"]
        },
        {
            "command": "env",
            "description": "Test -0 (null-terminated output)",
            "args": ["-0", "-i", "A=1", "B=2"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "A=1\u0000B=2\u0000",
                    "stderr": ""
                }
            }
        },
        {
            "command": "env",
            "description": "Test -S (split string)",
            "args": ["-S", "A=1 B=2", "env"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": null,
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "echo \"$CMD_STDOUT\" | grep -q 'A=1'",
                        "expected_exit": 0
                    },
                    {
                        "command": "echo \"$CMD_STDOUT\" | grep -q 'B=2'",
                        "expected_exit": 0
                    }
                ]
            }
        },
        {
            "command": "env",
            "description": "Test -- to end options",
            "args": ["--", "echo", "test"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "test\n",
                    "stderr": ""
                }
            }
        },
        {
            "command": "env",
            "description": "-S仅允许GNU的${VARNAME}变量展开；执行env -i -S A=$FOO；预期RC=125、stdout为空、stderr指出从$FOO开始的无效片段",
            "args": ["-i", "-S", "A=$FOO"],
            "environment": {
                "env_vars": {"FOO": "good"}
            },
            "expectation": {
                "execution": {
                    "exit_code": 125,
                    "stdout": "",
                    "stderr": "env: only ${VARNAME} expansion is supported, error at: $FOO\n"
                }
            }
        },
        {
            "command": "env",
            "description": "组合短选项中的-S应展开后续字符串；执行env -iS A=1；预期清环境后输出A=1和换行",
            "args": ["-iS", "A=1"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "A=1\n",
                    "stderr": ""
                }
            }
        },
        {
            "command": "env",
            "description": "-vS解析字符串时应输出GNU调试诊断；执行env -ivS A=1；预期stderr依次记录split-string、清环境和赋值步骤",
            "args": ["-ivS", "A=1"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "A=1\n",
                    "stderr": "split -S:  'A=1'\n into:    'A=1'\ncleaning environ\nsetenv:   A=1\n"
                }
            }
        },
        {
            "command": "env",
            "description": "--debug在-S之前出现时应输出GNU解析诊断；执行env --debug -i -S A=1；预期stderr记录split-string、清环境和赋值步骤",
            "args": ["--debug", "-i", "-S", "A=1"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "A=1\n",
                    "stderr": "split -S:  'A=1'\n into:    'A=1'\ncleaning environ\nsetenv:   A=1\n"
                }
            }
        },
        {
            "command": "env",
            "description": "--debug执行命令时采用GNU诊断布局；执行env --debug -i A=1 /usr/bin/printf ok；预期RC=0、stdout为ok、stderr逐行列出清环境、赋值和arg[0]起的执行参数",
            "args": ["--debug", "-i", "A=1", "/usr/bin/printf", "ok"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "ok",
                    "stderr": "cleaning environ\nsetenv:   A=1\nexecuting: /usr/bin/printf\n   arg[0]= '/usr/bin/printf'\n   arg[1]= 'ok'\n"
                }
            }
        },
        {
            "command": "env",
            "description": "--debug与-C组合时应在执行前报告目录切换；执行env --debug -i -C /tmp A=1 /usr/bin/true；预期stderr依次记录清环境、赋值、chdir和执行参数",
            "args": ["--debug", "-i", "-C", "/tmp", "A=1", "/usr/bin/true"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": "cleaning environ\nsetenv:   A=1\nchdir:    '/tmp'\nexecuting: /usr/bin/true\n   arg[0]= '/usr/bin/true'\n"
                }
            }
        },
        {
            "command": "env",
            "description": "--debug与-0及COMMAND冲突时应先应用并报告赋值；执行env --debug -0 A=1 /usr/bin/true；预期RC=125且stderr先输出setenv再报告--null不能与命令共用",
            "args": ["--debug", "-0", "A=1", "/usr/bin/true"],
            "expectation": {
                "execution": {
                    "exit_code": 125,
                    "stdout": "",
                    "stderr": "setenv:   A=1\nenv: cannot specify --null (-0) with command\nTry 'env --help' for more information.\n"
                }
            }
        },
        {
            "command": "env",
            "description": "--debug应在执行前输出信号处置和掩码变更；执行env --debug --ignore-signal=HUP --block-signal=PIPE /usr/bin/true；预期stderr按GNU顺序记录IGNORE、BLOCK和executing诊断",
            "args": [
                "--debug",
                "--ignore-signal=HUP",
                "--block-signal=PIPE",
                "/usr/bin/true"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": "Reset signal HUP (1) to IGNORE\nsignal PIPE (13) mask set to BLOCK\nexecuting: /usr/bin/true\n   arg[0]= '/usr/bin/true'\n"
                }
            }
        },
        {
            "command": "env",
            "description": "Linux信号29的调试名称应规范为POLL；执行env --debug --ignore-signal=IO /usr/bin/true；预期stderr显示POLL而非IO",
            "args": ["--debug", "--ignore-signal=IO", "/usr/bin/true"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": "Reset signal POLL (29) to IGNORE\nexecuting: /usr/bin/true\n   arg[0]= '/usr/bin/true'\n"
                }
            }
        },
        {
            "command": "env",
            "description": "无参数--ignore-signal的调试输出应记录不可变KILL和STOP的失败已忽略；执行env --debug --ignore-signal /usr/bin/true；预期stderr包含全部已知信号及两项failure ignored诊断",
            "args": ["--debug", "--ignore-signal", "/usr/bin/true"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": "Reset signal HUP (1) to IGNORE\nReset signal INT (2) to IGNORE\nReset signal QUIT (3) to IGNORE\nReset signal ILL (4) to IGNORE\nReset signal TRAP (5) to IGNORE\nReset signal ABRT (6) to IGNORE\nReset signal BUS (7) to IGNORE\nReset signal FPE (8) to IGNORE\nReset signal KILL (9) to IGNORE (failure ignored)\nReset signal USR1 (10) to IGNORE\nReset signal SEGV (11) to IGNORE\nReset signal USR2 (12) to IGNORE\nReset signal PIPE (13) to IGNORE\nReset signal ALRM (14) to IGNORE\nReset signal TERM (15) to IGNORE\nReset signal STKFLT (16) to IGNORE\nReset signal CHLD (17) to IGNORE\nReset signal CONT (18) to IGNORE\nReset signal STOP (19) to IGNORE (failure ignored)\nReset signal TSTP (20) to IGNORE\nReset signal TTIN (21) to IGNORE\nReset signal TTOU (22) to IGNORE\nReset signal URG (23) to IGNORE\nReset signal XCPU (24) to IGNORE\nReset signal XFSZ (25) to IGNORE\nReset signal VTALRM (26) to IGNORE\nReset signal PROF (27) to IGNORE\nReset signal WINCH (28) to IGNORE\nReset signal POLL (29) to IGNORE\nReset signal PWR (30) to IGNORE\nReset signal SYS (31) to IGNORE\nReset signal RTMIN (34) to IGNORE\nReset signal RTMIN+1 (35) to IGNORE\nReset signal RTMIN+2 (36) to IGNORE\nReset signal RTMIN+3 (37) to IGNORE\nReset signal RTMIN+4 (38) to IGNORE\nReset signal RTMIN+5 (39) to IGNORE\nReset signal RTMIN+6 (40) to IGNORE\nReset signal RTMIN+7 (41) to IGNORE\nReset signal RTMIN+8 (42) to IGNORE\nReset signal RTMIN+9 (43) to IGNORE\nReset signal RTMIN+10 (44) to IGNORE\nReset signal RTMIN+11 (45) to IGNORE\nReset signal RTMIN+12 (46) to IGNORE\nReset signal RTMIN+13 (47) to IGNORE\nReset signal RTMIN+14 (48) to IGNORE\nReset signal RTMIN+15 (49) to IGNORE\nReset signal RTMAX-14 (50) to IGNORE\nReset signal RTMAX-13 (51) to IGNORE\nReset signal RTMAX-12 (52) to IGNORE\nReset signal RTMAX-11 (53) to IGNORE\nReset signal RTMAX-10 (54) to IGNORE\nReset signal RTMAX-9 (55) to IGNORE\nReset signal RTMAX-8 (56) to IGNORE\nReset signal RTMAX-7 (57) to IGNORE\nReset signal RTMAX-6 (58) to IGNORE\nReset signal RTMAX-5 (59) to IGNORE\nReset signal RTMAX-4 (60) to IGNORE\nReset signal RTMAX-3 (61) to IGNORE\nReset signal RTMAX-2 (62) to IGNORE\nReset signal RTMAX-1 (63) to IGNORE\nReset signal RTMAX (64) to IGNORE\nexecuting: /usr/bin/true\n   arg[0]= '/usr/bin/true'\n"
                }
            }
        },
        {
            "command": "env",
            "description": "不可阻塞KILL和STOP仍应记录请求的掩码调试动作；执行env --debug --block-signal=KILL,STOP /usr/bin/true；预期stderr包含两条BLOCK诊断",
            "args": ["--debug", "--block-signal=KILL,STOP", "/usr/bin/true"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": "signal KILL (9) mask set to BLOCK\nsignal STOP (19) mask set to BLOCK\nexecuting: /usr/bin/true\n   arg[0]= '/usr/bin/true'\n"
                }
            }
        },
