        {
            "command": "env",
            "description": "显式空信号参数不应变更处理方式；执行env --ignore-signal= /bin/sh -c kill -TERM $$; printf survived；预期SIGTERM终止子进程，RC=143且stdout、stderr为空",
            "args": [
                "--ignore-signal=",
                "/bin/sh",
                "-c",
                "kill -TERM $$; printf survived"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 143,
                    "stdout": "",
                    "stderr": ""
                }
            }
        },
        {
            "command": "env",
            "description": "default-signal会解除此前对同一信号的阻塞；执行env --block-signal=HUP --default-signal=HUP /bin/sh -c kill -HUP $$; printf survived；预期SIGHUP终止子进程，RC=129且stdout、stderr为空",
            "args": [
                "--block-signal=HUP",
                "--default-signal=HUP",
                "/bin/sh",
                "-c",
                "kill -HUP $$; printf survived"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 129,
                    "stdout": "",
                    "stderr": ""
                }
