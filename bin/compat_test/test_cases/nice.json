            "environment": {
                "env_vars": {
                    "LC_ALL": "C",
                    "LANG": "C"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "ff",
                    "stderr": ""
                }
            },
            "tags": [
                "raw-bytes",
                "non-utf8",
                "command-arguments"
            ]
        },
