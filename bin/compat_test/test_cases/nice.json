{
    "tests": [
        {
            "tstdin": "",
            "byteMode": true,
            "command": "nice",
            "description": "原始字节命令参数用例：LC_ALL=C下执行nice /usr/bin/printf %s并传入单字节0xff参数；参数完整十六进制=2f7573722f62696e2f7072696e7466 2573 ff；stdin完整十六进制=空；GNU必须保留参数原始字节，预期RC=0、stdout完整十六进制=ff、stderr完整十六进制=空。",
            "args": [
                "2f7573722f62696e2f7072696e7466",
                "2573",
                "ff"
            ],
            "environment": {
                "env_vars": {
                    "LC_ALL": "C",
                    "LANG": "C"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "ff",
                    "stderr": ""
                }
            },
            "tags": [
                "raw-bytes",
                "non-utf8",
                "command-arguments"
            ]
        },
        {
            "tstdin": "",
            "byteMode": true,
            "command": "nice",
            "description": "原始字节COMMAND诊断用例：LC_ALL=C下执行nice并传入单字节0xff作为COMMAND；参数完整十六进制=ff；stdin完整十六进制=空；GNU quote() 将不可打印命令名表示为'\\377'，预期RC=127、stdout完整十六进制=空、stderr完整十六进制=6e6963653a20275c333737273a204e6f20737563682066696c65206f72206469726563746f72790a。",
            "args": [
                "ff"
            ],
            "environment": {
                "env_vars": {
                    "LC_ALL": "C",
                    "LANG": "C"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 127,
                    "stdout": "",
                    "stderr": "6e6963653a20275c333737273a204e6f20737563682066696c65206f72206469726563746f72790a"
                }
            },
            "tags": [
                "raw-bytes",
                "non-utf8",
                "diagnostics",
                "locale-quoting"
            ]
        },
        {
            "tstdin": "",
            "byteMode": true,
            "command": "nice",
            "description": "C locale引用转义用例：LC_ALL=C下以a、单引号和反斜杠组成不存在的COMMAND；参数完整十六进制=61275c；stdin完整十六进制=空；GNU quote() 必须分别转义单引号和反斜杠，预期RC=127、stdout完整十六进制=空、stderr完整十六进制=6e6963653a2027615c275c5c273a204e6f20737563682066696c65206f72206469726563746f72790a。",
            "args": [
                "61275c"
            ],
            "environment": {
                "env_vars": {
                    "LC_ALL": "C",
                    "LANG": "C"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 127,
                    "stdout": "",
                    "stderr": "6e6963653a2027615c275c5c273a204e6f20737563682066696c65206f72206469726563746f72790a"
                }
            },
            "tags": [
                "diagnostics",
                "locale-quoting",
                "escaping"
            ]
        },
        {
            "command": "nice",
            "description": "传统调整值溢出用例：LC_ALL=C下执行nice -+9223372036854775808 /usr/bin/true；GNU先按首数字识别传统-+N形式，再将溢出值夹到允许的最大调整值；预期RC=0且标准输出、标准错误均为空。",
            "args": [
                "-+9223372036854775808",
                "/usr/bin/true"
            ],
            "environment": {
                "env_vars": {
                    "LC_ALL": "C",
                    "LANG": "C"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                }
            },
            "tags": [
                "legacy-adjustment",
                "numeric-overflow"
            ]
        },
        {
            "command": "nice",
            "description": "传统调整值无效后缀用例：LC_ALL=C下执行nice --1a /usr/bin/true；GNU先把--1a识别为传统调整值-1a，再报告invalid adjustment；预期RC=125、stdout为空、stderr为nice: invalid adjustment '-1a'的C locale ASCII引用文本。",
            "args": [
                "--1a",
                "/usr/bin/true"
            ],
            "environment": {
                "env_vars": {
                    "LC_ALL": "C",
                    "LANG": "C"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 125,
                    "stdout": "",
                    "stderr": "nice: invalid adjustment '-1a'\n"
                }
            },
            "tags": [
                "legacy-adjustment",
                "diagnostics"
            ]
        },
        {
            "command": "nice",
            "description": "GNU xstrtol允许-n参数的前导ASCII空白，并将超出long范围的正数夹到可用的最大niceness adjustment。",
            "args": ["-n", " 9223372036854775808", "/usr/bin/true"],
            "environment": {
                "env_vars": {"LC_ALL": "C", "LANG": "C"}
            },
            "expectation": {
                "execution": {"exit_code": 0, "stdout": "", "stderr": ""}
            },
            "tags": ["adjustment", "numeric-overflow", "leading-whitespace"]
        },
