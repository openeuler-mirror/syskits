        {
            "tstdin": "",
            "command": "nohup",
            "description": "LC_ALL=C下启动前关闭stdout且仅stderr连接PTY；执行命令向stderr写入redirected。GNU创建0600的nohup.out，将命令stderr写入文件，并先后在原TTY stderr报告appending output和redirecting stderr to stdout",
            "args": [
                "sh",
                "-c",
                "printf redirected >&2"
            ],
            "setup_commands": [
                "export LC_ALL='C'",
                "export LANG='C'"
            ],
            "environment": {
                "standardStreams": {
                    "stdout": "closed",
                    "stderr": "tty"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": "nohup: appending output to 'nohup.out'\nnohup: redirecting stderr to stdout\n"
                },
                "verifications": [
                    {
                        "command": "stat -c '%a:%s' nohup.out",
                        "expected_exit": 0,
                        "expected_stdout": "600:10\n",
                        "expected_stderr": ""
                    },
                    {
                        "command": "cat nohup.out",
                        "expected_exit": 0,
                        "expected_stdout": "redirected",
                        "expected_stderr": ""
                    }
                ]
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "nohup",
            "description": "LC_ALL=C下stdout和stderr均连接独立PTY且命令不存在；GNU在重定向前保存原stderr，因此failed to run command诊断仍输出到原TTY，nohup.out仅创建且保持0600、0字节",
            "args": ["no-such-command"],
            "setup_commands": [
                "export LC_ALL='C'",
                "export LANG='C'"
            ],
            "environment": {
                "standardStreams": {
                    "stdout": "tty",
                    "stderr": "tty"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 127,
                    "stdout": "",
                    "stderr": "nohup: appending output to 'nohup.out'\nnohup: failed to run command 'no-such-command': No such file or directory\n"
                },
                "verifications": [
                    {
                        "command": "stat -c '%a:%s' nohup.out",
                        "expected_exit": 0,
                        "expected_stdout": "600:0\n",
                        "expected_stderr": ""
                    }
                ]
            },
            "cleanup_commands": []
        },
        {
