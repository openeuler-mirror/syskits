{
    "tests": [
        {
            "tstdin": "",
            "command": "nohup",
            "description": "LC_ALL=C下将-h作为nohup选项传入；GNU只支持--help，预期返回125并输出invalid option -- 'h'和帮助提示，而不是显示帮助内容",
            "args": ["-h"],
            "environment": {
                "env_vars": {"LC_ALL": "C", "LANG": "C"}
            },
            "expectation": {
                "execution": {
                    "exit_code": 125,
                    "stdout": "",
                    "stderr": "nohup: invalid option -- 'h'\nTry 'nohup --help' for more information.\n"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "byteMode": true,
            "command": "nohup",
            "description": "原始字节选项用例：LC_ALL=C下传入字节2d2d626164ff（--bad加0xff）；GNU保留非法UTF-8字节于unrecognized option诊断，预期RC=125、stdout为空、stderr完整十六进制=6e6f6875703a20756e7265636f676e697a6564206f7074696f6e20272d2d626164ff270a54727920276e6f687570202d2d68656c702720666f72206d6f726520696e666f726d6174696f6e2e0a",
            "args": ["2d2d626164ff"],
            "environment": {
                "env_vars": {"LC_ALL": "C", "LANG": "C"}
            },
            "expectation": {
                "execution": {
                    "exit_code": 125,
                    "stdout": "",
                    "stderr": "6e6f6875703a20756e7265636f676e697a6564206f7074696f6e20272d2d626164ff270a54727920276e6f687570202d2d68656c702720666f72206d6f726520696e666f726d6174696f6e2e0a"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "nohup",
            "description": "LC_ALL=C下不传COMMAND；GNU nohup返回125，并以missing operand和Try 'nohup --help'的专用诊断提示缺少操作数",
            "args": [],
            "environment": {
                "env_vars": {"LC_ALL": "C", "LANG": "C"}
            },
            "expectation": {
                "execution": {
                    "exit_code": 125,
                    "stdout": "",
                    "stderr": "nohup: missing operand\nTry 'nohup --help' for more information.\n"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "nohup",
            "description": "LC_ALL=C且POSIXLY_CORRECT=1下不传COMMAND；GNU nohup保持missing operand诊断，但POSIX模式内部失败状态为127",
            "args": [],
            "environment": {
                "env_vars": {"LC_ALL": "C", "LANG": "C", "POSIXLY_CORRECT": "1"}
            },
            "expectation": {
                "execution": {
                    "exit_code": 127,
                    "stdout": "",
                    "stderr": "nohup: missing operand\nTry 'nohup --help' for more information.\n"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "byteMode": true,
            "command": "nohup",
            "description": "原始字节命令路径用例：LC_ALL=C下创建并执行路径字节2e2f636d642dff（./cmd-加0xff）；GNU nohup保留argv原始字节并输出byte-ok，预期RC=0、stdout完整十六进制=627974652d6f6b、stderr为空",
            "setup_commands": [
                "export LC_ALL='C' LANG='C'",
                "printf '#!/bin/sh\\nprintf byte-ok\\n' > \"$(printf 'cmd-\\377')\"",
                "chmod +x \"$(printf 'cmd-\\377')\""
            ],
            "args": ["2e2f636d642dff"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "627974652d6f6b",
                    "stderr": ""
                }
            },
            "cleanup_commands": ["rm -f \"$(printf 'cmd-\\377')\""]
        },
        {
            "tstdin": "",
            "command": "nohup",
            "description": "LC_ALL=C且三个标准流均非TTY时执行不存在命令，GNU nohup返回127并使用failed to run command诊断，且不附加Rust错误码后缀",
            "args": ["no-such-command"],
            "environment": {
                "env_vars": {"LC_ALL": "C", "LANG": "C"},
                "standardStreams": {"stderr": "capture"}
            },
            "expectation": {
                "execution": {
                    "exit_code": 127,
                    "stdout": "",
                    "stderr": "nohup: failed to run command 'no-such-command': No such file or directory\n"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "nohup",
            "description": "基本功能测试 - 运行命令并忽略挂起信号",
            "setup_commands": [
            ],
            "args": ["echo", "hello"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "nohup: 忽略输入并把输出追加到'nohup.out'\n",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "cat nohup.out",
                        "expected_exit": 0,
                        "expected_stdout": "hello\n"
                    }
                ]
            },
            "cleanup_commands": [
                "rm -f nohup.out"
            ]
        },
        {
            "tstdin": "",
            "command": "nohup",
            "description": "输出重定向到指定文件",
            "setup_commands": [
                "mkdir -p test_dir"
            ],
            "args": ["sh", "-c", "echo hello > test_dir/output.txt"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "nohup: 忽略输入并把输出追加到'nohup.out'\n",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "cat test_dir/output.txt",
                        "expected_exit": 0,
                        "expected_stdout": "hello\n"
                    }
                ]
            },
            "cleanup_commands": [
                "rm -f nohup.out",
                "rm -rf test_dir"
            ]
        },
        {
            "tstdin": "",
            "command": "nohup",
            "description": "执行多命令",
            "setup_commands": [
            ],
            "args": ["sh", "-c", "echo hello && echo world"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "nohup: 忽略输入并把输出追加到'nohup.out'\n",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "cat nohup.out",
                        "expected_exit": 0,
                        "expected_stdout": "hello\nworld\n"
                    }
                ]
            },
            "cleanup_commands": [
                "rm -f nohup.out"
            ]
        },
        {
            "tstdin": "",
            "command": "nohup",
            "description": "执行不存在的命令",
            "setup_commands": [],
            "args": ["nonexistentcommand123"],
            "expectation": {
                "execution": {
                    "exit_code": 127,
                    "stdout": "nohup: 忽略输入并把输出追加到'nohup.out'\n",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "cat nohup.out",
                        "expected_exit": 0,
                        "expected_stdout": "nohup: failed to run command 'nonexistentcommand123': No such file or directory\n"
                    }
                ],
                "ignore_fields": {
                    "ignore_exit_code": true,
                    "ignore_stdout": true
                }
            },
            "cleanup_commands": [
                "rm -f nohup.out"
            ]
        },
        {
            "tstdin": "",
            "command": "nohup",
            "description": "不带参数运行",
            "setup_commands": [],
            "args": [],
            "expectation": {
                "execution": {
                    "exit_code": 125,
                    "stdout": "",
                    "stderr": "nohup: 缺少操作数\n请尝试执行 'nohup --help' 来获取更多信息。\n"
                },
                "verifications": []
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "tty": true,
            "command": "nohup",
            "description": "LC_ALL=C的TTY环境执行nohup /bin/sh -c 'printf output'；输入为空；预期RC=0并创建内容为output、权限0600的nohup.out；迁移原Cargo用例nohup_creates_output_with_private_permissions",
            "args": [
                "/bin/sh",
                "-c",
                "printf output"
            ],
            "setup_commands": [
                "export LC_ALL='C'",
                "export LANG='C'"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "stat -c '%a:%s' 'nohup.out'",
                        "expected_exit": 0,
                        "expected_stdout": "",
                        "expected_stderr": ""
                    },
                    {
                        "command": "od -An -v -tx1 'nohup.out'",
                        "expected_exit": 0,
                        "expected_stdout": "",
                        "expected_stderr": ""
                    }
                ]
            },
            "cleanup_commands": [],
            "timeout": 5
        },
        {
            "tstdin": "",
            "tty": true,
            "command": "nohup",
            "description": "LC_ALL=C的TTY环境执行nohup /bin/sh -c 'printf output'；当前目录nohup.out为目录且HOME指向home；预期RC=0并回退创建内容为output、权限0600的home/nohup.out；迁移原Cargo用例nohup_falls_back_to_home_with_private_permissions",
            "args": [
                "/bin/sh",
                "-c",
                "printf output"
            ],
            "setup_commands": [
                "export LC_ALL='C'",
                "export LANG='C'",
                "mkdir -p home nohup.out",
                "export HOME='home'"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "ignore_fields": {
                    "ignore_stderr": true
                },
                "verifications": [
                    {
                        "command": "stat -c '%a:%s' 'home/nohup.out'",
                        "expected_exit": 0,
                        "expected_stdout": "",
                        "expected_stderr": ""
                    },
                    {
                        "command": "od -An -v -tx1 'home/nohup.out'",
                        "expected_exit": 0,
                        "expected_stdout": "",
                        "expected_stderr": ""
                    }
                ]
            },
            "cleanup_commands": [],
            "timeout": 5
        },
        {
            "tstdin": "",
            "tty": true,
            "command": "nohup",
            "description": "输出文件打开失败诊断用例：LC_ALL=C下当前nohup.out为目录、HOME=missing-home；GNU返回125，并依次报告Is a directory与No such file or directory，errno文本不包含Rust的(os error N)后缀。",
            "args": ["true"],
            "setup_commands": [
                "export LC_ALL='C'",
                "export LANG='C'",
                "mkdir nohup.out",
                "export HOME='missing-home'"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 125,
                    "stdout": "",
                    "stderr": ""
                }
            },
            "cleanup_commands": [],
            "timeout": 5
        },
        {
            "tstdin": "",
            "byteMode": true,
            "tty": true,
            "command": "nohup",
            "description": "原始字节HOME回退用例：LC_ALL=C下将HOME设为字节686f6d652dff（home-加0xff），当前目录nohup.out为目录；GNU需回退创建该HOME/nohup.out并写入字节6f7574707574（output），而不能因HOME非UTF-8拒绝回退。",
            "args": [
                "2f62696e2f7368",
                "2d63",
                "7072696e7466206f7574707574"
            ],
            "setup_commands": [
                "export LC_ALL='C'",
                "export LANG='C'",
                "mkdir nohup.out \"$(printf 'home-\\377')\""
            ],
            "environment": {
                "envBytes": {"HOME": "686f6d652dff"}
            },
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "python3 -c 'import os, stat; result = os.stat(b\"home-\\xff/nohup.out\"); print(f\"{stat.S_IMODE(result.st_mode):o}:{result.st_size}\")'",
                        "expected_exit": 0,
                        "expected_stdout": "600:6\n",
                        "expected_stderr": ""
                    },
                    {
                        "command": "python3 -c 'print(open(b\"home-\\xff/nohup.out\", \"rb\").read().hex())'",
                        "expected_exit": 0,
                        "expected_stdout": "6f7574707574\n",
                        "expected_stderr": ""
                    }
                ]
            },
            "cleanup_commands": [],
            "timeout": 5
        },
        {
