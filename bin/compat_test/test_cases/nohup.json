                    "stdout": "",
                    "stderr": "nohup: redirecting stderr to stdout\n"
                }
            },
            "environment": {
                "standardStreams": {
                    "stderr": "tty"
                }
            },
            "cleanup_commands": [],
            "timeout": 5
        }
    ]
