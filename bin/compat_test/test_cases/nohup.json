{
    "tests": [
        {
            "tstdin": "",
            "byteMode": true,
            "command": "nohup",
            "description": "原始字节命令路径用例：LC_ALL=C下创建并执行路径字节2e2f636d642dff（./cmd-加0xff）；GNU nohup保留argv原始字节并输出byte-ok，预期RC=0、stdout完整十六进制=627974652d6f6b、stderr为空",
            "setup_commands": [
                "export LC_ALL='C' LANG='C'",
                "printf '#!/bin/sh\\nprintf byte-ok\\n' > \"$(printf 'cmd-\\377')\"",
                "chmod +x \"$(printf 'cmd-\\377')\""
            ],
            "args": ["2e2f636d642dff"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "627974652d6f6b",
                    "stderr": ""
                }
            },
            "cleanup_commands": ["rm -f \"$(printf 'cmd-\\377')\""]
        },
        {
            "tstdin": "",
            "command": "nohup",
            "description": "LC_ALL=C且三个标准流均非TTY时执行不存在命令，GNU nohup返回127并使用failed to run command诊断，且不附加Rust错误码后缀",
            "args": ["no-such-command"],
            "environment": {
                "env_vars": {"LC_ALL": "C", "LANG": "C"},
                "standardStreams": {"stderr": "capture"}
            },
            "expectation": {
                "execution": {
                    "exit_code": 127,
                    "stdout": "",
                    "stderr": "nohup: failed to run command 'no-such-command': No such file or directory\n"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "nohup",
            "description": "基本功能测试 - 运行命令并忽略挂起信号",
            "setup_commands": [
            ],
            "args": ["echo", "hello"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "nohup: 忽略输入并把输出追加到'nohup.out'\n",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "cat nohup.out",
                        "expected_exit": 0,
                        "expected_stdout": "hello\n"
                    }
                ]
            },
            "cleanup_commands": [
                "rm -f nohup.out"
            ]
        },
        {
            "tstdin": "",
            "command": "nohup",
            "description": "输出重定向到指定文件",
            "setup_commands": [
                "mkdir -p test_dir"
            ],
            "args": ["sh", "-c", "echo hello > test_dir/output.txt"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "nohup: 忽略输入并把输出追加到'nohup.out'\n",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "cat test_dir/output.txt",
                        "expected_exit": 0,
                        "expected_stdout": "hello\n"
                    }
                ]
            },
            "cleanup_commands": [
                "rm -f nohup.out",
                "rm -rf test_dir"
            ]
        },
        {
            "tstdin": "",
            "command": "nohup",
            "description": "执行多命令",
            "setup_commands": [
            ],
            "args": ["sh", "-c", "echo hello && echo world"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "nohup: 忽略输入并把输出追加到'nohup.out'\n",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "cat nohup.out",
                        "expected_exit": 0,
                        "expected_stdout": "hello\nworld\n"
                    }
                ]
            },
            "cleanup_commands": [
                "rm -f nohup.out"
            ]
        },
        {
            "tstdin": "",
            "command": "nohup",
            "description": "执行不存在的命令",
            "setup_commands": [],
            "args": ["nonexistentcommand123"],
            "expectation": {
                "execution": {
                    "exit_code": 127,
                    "stdout": "nohup: 忽略输入并把输出追加到'nohup.out'\n",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "cat nohup.out",
                        "expected_exit": 0,
                        "expected_stdout": "nohup: failed to run command 'nonexistentcommand123': No such file or directory\n"
                    }
                ],
                "ignore_fields": {
                    "ignore_exit_code": true,
                    "ignore_stdout": true
                }
            },
            "cleanup_commands": [
                "rm -f nohup.out"
            ]
        },
        {
            "tstdin": "",
            "command": "nohup",
            "description": "不带参数运行",
            "setup_commands": [],
            "args": [],
            "expectation": {
                "execution": {
                    "exit_code": 125,
                    "stdout": "",
                    "stderr": "nohup: 缺少操作数\n请尝试执行 'nohup --help' 来获取更多信息。\n"
                },
                "verifications": []
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "tty": true,
            "command": "nohup",
            "description": "LC_ALL=C的TTY环境执行nohup /bin/sh -c 'printf output'；输入为空；预期RC=0并创建内容为output、权限0600的nohup.out；迁移原Cargo用例nohup_creates_output_with_private_permissions",
            "args": [
                "/bin/sh",
                "-c",
                "printf output"
            ],
            "setup_commands": [
                "export LC_ALL='C'",
                "export LANG='C'"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "stat -c '%a:%s' 'nohup.out'",
                        "expected_exit": 0,
                        "expected_stdout": "",
                        "expected_stderr": ""
                    },
                    {
                        "command": "od -An -v -tx1 'nohup.out'",
                        "expected_exit": 0,
                        "expected_stdout": "",
                        "expected_stderr": ""
                    }
                ]
            },
            "cleanup_commands": [],
            "timeout": 5
        },
        {
            "tstdin": "",
            "tty": true,
            "command": "nohup",
            "description": "LC_ALL=C的TTY环境执行nohup /bin/sh -c 'printf output'；当前目录nohup.out为目录且HOME指向home；预期RC=0并回退创建内容为output、权限0600的home/nohup.out；迁移原Cargo用例nohup_falls_back_to_home_with_private_permissions",
            "args": [
                "/bin/sh",
                "-c",
                "printf output"
            ],
            "setup_commands": [
                "export LC_ALL='C'",
                "export LANG='C'",
                "mkdir -p home nohup.out",
                "export HOME='home'"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "ignore_fields": {
                    "ignore_stderr": true
                },
                "verifications": [
                    {
                        "command": "stat -c '%a:%s' 'home/nohup.out'",
                        "expected_exit": 0,
                        "expected_stdout": "",
                        "expected_stderr": ""
                    },
                    {
                        "command": "od -An -v -tx1 'home/nohup.out'",
                        "expected_exit": 0,
                        "expected_stdout": "",
                        "expected_stderr": ""
                    }
                ]
            },
            "cleanup_commands": [],
            "timeout": 5
        },
        {
            "tstdin": "",
            "tty": true,
            "command": "nohup",
            "description": "LC_ALL=C的TTY环境执行nohup /bin/sh -c 'printf output'；输入fixture为权限0640且内容existing的nohup.out；预期RC=0、追加为existingoutput并保留0640权限；迁移原Cargo用例nohup_preserves_existing_output_permissions",
            "args": [
                "/bin/sh",
                "-c",
                "printf output"
            ],
            "setup_commands": [
                "export LC_ALL='C'",
                "export LANG='C'",
                "printf existing > nohup.out",
                "chmod 640 nohup.out"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "stat -c '%a:%s' 'nohup.out'",
                        "expected_exit": 0,
                        "expected_stdout": "",
                        "expected_stderr": ""
                    },
                    {
                        "command": "od -An -v -tx1 'nohup.out'",
                        "expected_exit": 0,
                        "expected_stdout": "",
                        "expected_stderr": ""
                    }
                ]
            },
            "cleanup_commands": [],
            "timeout": 5
        },
        {
            "tstdin": "",
            "tty": true,
            "command": "nohup",
            "description": "LC_ALL=C的TTY环境执行nohup /bin/sh -c 'read x; echo read_rc=$?'；输入为空；预期RC=0，子进程stdin为不可读描述符，nohup.out包含Bad file descriptor并以read_rc=1结尾；迁移原Cargo用例nohup_makes_tty_stdin_unreadable",
            "args": [
                "/bin/sh",
                "-c",
                "read x; echo read_rc=$?"
            ],
            "setup_commands": [
                "export LC_ALL='C'",
                "export LANG='C'"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "stat -c '%a:%s' 'nohup.out'",
                        "expected_exit": 0,
                        "expected_stdout": "",
                        "expected_stderr": ""
                    },
                    {
                        "command": "od -An -v -tx1 'nohup.out'",
                        "expected_exit": 0,
                        "expected_stdout": "",
                        "expected_stderr": ""
                    }
                ]
            },
            "cleanup_commands": [],
            "timeout": 5
        },
        {
            "tstdin": "",
            "command": "nohup",
            "description": "LC_ALL=C、LANG=C下执行nohup true；stdin为空管道、stdout为非TTY捕获管道，仅stderr连接PTY；无文件fixture；预期RC=0、stdout为空，PTY stderr规范化为nohup: redirecting stderr to stdout加换行；迁移原Cargo用例nohup_reports_tty_stderr_redirection",
            "args": [
                "true"
            ],
            "setup_commands": [
                "export LC_ALL='C'",
                "export LANG='C'"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": "nohup: redirecting stderr to stdout\n"
                }
            },
            "environment": {
                "standardStreams": {
                    "stderr": "tty"
                }
            },
            "cleanup_commands": [],
            "timeout": 5
        }
    ]
}
