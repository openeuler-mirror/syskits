                "verifications": [
                    {
                        "command": "stat -c '%a:%s' 'nohup.out'",
                        "expected_exit": 0,
                        "expected_stdout": "",
                        "expected_stderr": ""
                    },
                    {
                        "command": "od -An -v -tx1 'nohup.out'",
                        "expected_exit": 0,
