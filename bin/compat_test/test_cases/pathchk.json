{
  "tests": [
    {
      "tstdin": "",
      "command": "pathchk",
      "description": "测试基本的短文件名",
      "args": [
        "-p",
        "a"
      ],
      "expectation": {
        "execution": {
          "exit_code": 0,
          "stdout": "",
          "stderr": ""
        }
      },
      "timeout": 5,
      "tags": [
        "basic",
        "short-filename"
      ]
    },
    {
      "tstdin": "",
      "command": "pathchk",
      "description": "测试最大长度文件名（255字符）",
      "args": [
        "-p",
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      ],
      "expectation": {
        "execution": {
          "exit_code": 0,
          "stdout": "",
          "stderr": ""
        }
      },
      "timeout": 5,
      "tags": [
        "boundary",
        "max-length"
      ]
    },
    {
      "tstdin": "",
      "command": "pathchk",
      "description": "测试包含特殊字符的文件名",
      "args": [
        "-p",
        "special#file$name"
      ],
      "expectation": {
        "execution": {
          "exit_code": 1,
          "stdout": "",
          "stderr": "pathchk: 'special#file$name': 文件名包含非法字符\n"
        },
        "use_patterns": true
      },
      "timeout": 5,
      "tags": [
        "special-chars",
        "error-handling"
      ]
    },
    {
      "tstdin": "",
      "command": "pathchk",
      "description": "测试空文件名",
      "args": [
        "-p",
        ""
      ],
      "expectation": {
        "execution": {
          "exit_code": 1,
          "stdout": "",
          "stderr": "pathchk: '': 文件名为空\n"
        },
        "use_patterns": true
      },
      "timeout": 5,
      "tags": [
        "empty-filename",
        "error-handling"
      ]
    },
    {
      "tstdin": "",
      "command": "pathchk",
      "description": "测试深层嵌套路径",
      "args": [
        "-p",
        "deep/nested/path/valid_filename"
      ],
      "expectation": {
        "execution": {
          "exit_code": 0,
          "stdout": "",
          "stderr": ""
        }
      },
      "timeout": 5,
      "tags": [
        "deep-path",
        "directory-structure"
      ]
    },
    {
      "tstdin": "",
      "command": "pathchk",
      "description": "测试不存在的路径",
      "args": [
        "-p",
        "non_existent_directory/file"
      ],
      "expectation": {
        "execution": {
          "exit_code": 0,
          "stdout": "",
          "stderr": ""
        }
      },
      "timeout": 5,
      "tags": [
        "non-existent",
        "validation"
      ]
    },
    {
      "tstdin": "",
      "command": "pathchk",
      "description": "pathchk: 首个路径后的-p按路径名处理",
      "args": [
        "name#",
        "-p"
      ],
      "expectation": {
        "execution": {
          "exit_code": 0,
          "stdout": "",
          "stderr": ""
        }
      },
      "timeout": 5,
      "tags": [
        "options",
        "posix-option-order"
      ]
    },
    {
      "tstdin": "",
      "byteMode": true,
      "command": "pathchk",
      "description": "原始字节用例：LC_ALL=C、LANG=C下执行pathchk -p，参数完整十六进制=2d70 ff，其中ff为非UTF-8路径字节；stdin为0字节、完整十六进制=空；预期RC=1、stdout为空，stderr为pathchk: non-portable character '\\377' in file name ''$'\\377'\\n，完整十六进制=7061746863686b3a206e6f6e2d706f727461626c652063686172616374657220275c3337372720696e2066696c65206e616d6520272724275c333737270a。",
      "args": [
        "2d70",
        "ff"
      ],
      "environment": {
        "clearEnv": true,
        "env_vars": {
          "LC_ALL": "C",
          "LANG": "C"
        }
      },
      "expectation": {
        "execution": {
          "exit_code": 1,
          "stdout": "",
          "stderr": "7061746863686b3a206e6f6e2d706f727461626c652063686172616374657220275c3337372720696e2066696c65206e616d6520272724275c333737270a"
        }
      },
      "timeout": 5,
      "tags": [
        "raw-bytes",
        "non-utf8",
        "diagnostics"
      ]
    },
    {
      "tstdin": "",
      "command": "pathchk",
      "description": "pathchk: -p只检查可移植名称，不检查普通文件后的子路径是否可搜索",
      "args": [
        "-p",
        "pathchk-file/child"
      ],
      "setup_commands": [
        "/usr/bin/printf data > pathchk-file"
      ],
      "cleanup_commands": [
        "/usr/bin/rm -f pathchk-file"
      ],
      "expectation": {
        "execution": {
          "exit_code": 0,
          "stdout": "",
          "stderr": ""
        }
      },
      "timeout": 5,
      "tags": [
        "portability",
        "filesystem"
      ]
    },
    {
      "tstdin": "",
      "command": "pathchk",
      "description": "pathchk: -p对256字节单组件先报告总路径限制255，输入为256个ASCII字符a",
      "args": [
        "-p",
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      ],
      "expectation": {
        "execution": {
          "exit_code": 1,
          "stdout": "",
          "stderr": ""
        }
      },
      "timeout": 5,
      "tags": [
        "portability",
        "path-length",
        "boundary"
      ]
    },
    {
      "tstdin": "",
      "command": "pathchk",
      "description": "pathchk: --portability先检查组件前导连字符，再检查非可移植字符",
      "args": [
        "-p",
        "-P",
        "--",
        "-#"
      ],
      "expectation": {
        "execution": {
          "exit_code": 1,
          "stdout": "",
          "stderr": "pathchk: leading '-' in a component of file name '-#'\n"
        }
      },
      "timeout": 5,
      "tags": [
        "portability",
        "diagnostics",
        "check-order"
      ]
    },
    {
      "tstdin": "",
      "command": "pathchk",
      "description": "pathchk: 默认模式空路径使用lstat的No such file or directory诊断，-p/-P才报告empty file name",
      "args": [
        ""
      ],
      "expectation": {
        "execution": {
          "exit_code": 1,
          "stdout": "",
          "stderr": "pathchk: '': No such file or directory\n"
        }
      },
      "timeout": 5,
      "tags": [
        "default-mode",
        "empty-path",
        "diagnostics"
      ]
    },
    {
      "tstdin": "",
      "command": "pathchk",
      "description": "pathchk: 默认模式先执行lstat，普通文件后的子路径报Not a directory且安全路径不额外加引号",
      "args": [
        "pathchk-file/child"
      ],
      "setup_commands": [
        "/usr/bin/printf data > pathchk-file"
      ],
      "cleanup_commands": [
        "/usr/bin/rm -f pathchk-file"
      ],
      "expectation": {
        "execution": {
          "exit_code": 1,
          "stdout": "",
          "stderr": "pathchk: pathchk-file/child: Not a directory\n"
        }
      },
      "timeout": 5,
      "tags": [
        "default-mode",
        "filesystem",
        "diagnostics"
      ]
    },
    {
      "tstdin": "",
      "command": "pathchk",
      "description": "pathchk: 重复或合并的-p、-P及重复--portability均为幂等布尔选项",
      "args": [
        "-pp",
        "-PP",
        "--portability",
        "--portability",
        "a"
      ],
      "expectation": {
        "execution": {
          "exit_code": 0,
          "stdout": "",
          "stderr": ""
        }
      },
      "timeout": 5,
      "tags": [
        "options",
        "repeated-options",
        "short-option-cluster"
      ]
    }
  ]
}
