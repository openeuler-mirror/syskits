{
    "tests": [
        {
            "command": "pr",
            "description": "pr --help",
            "args": [
                "--help"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "ignore_fields": {
                    "ignore_stdout": true,
                    "ignore_stderr": true
                }
            }
        },
        {
            "command": "pr",
            "description": "pr --version",
            "args": [
                "--version"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "ignore_fields": {
                    "ignore_stdout": true,
                    "ignore_stderr": true
                }
            }
        },
        {
            "command": "pr",
            "description": "Basic format",
            "args": [
                "f1"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "\n\n2026-02-28 14:28                       f1                        第 1 页\n\n\nline1\nline2\nline3\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n",
                    "stderr": ""
                }
            },
            "setup_commands": [
                "echo -e 'line1\nline2\nline3' > f1"
            ],
            "cleanup_commands": [
                "rm -f f1"
            ]
        },
        {
            "command": "pr",
            "description": "Pagination control (+PAGE:END)",
            "args": [
                "+1:1",
                "f1"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "\n\n2026-02-28 14:28                       f1                        第 1 页\n\n\nl1\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n",
                    "stderr": ""
                }
            },
            "setup_commands": [
                "echo -ne 'l1\n\\fl2\n' > f1"
            ],
            "cleanup_commands": [
                "rm -f f1"
            ]
        },
        {
