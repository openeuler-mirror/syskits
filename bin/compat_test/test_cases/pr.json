            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "\n\n2026-02-28 14:28                       f1                        第 2 页\n\n\nl2\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n\n",
