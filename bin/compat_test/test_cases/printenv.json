{
    "tests": [
        {
            "tstdin": "",
            "command": "printenv",
            "description": "基本功能测试 - 显示所有环境变量",
            "args": [],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "ignore_fields": {
                    "ignore_stdout": true
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "printenv",
            "description": "显示指定的环境变量",
            "args": ["TEST_VAR"],
            "setup_commands": [
                "export TEST_VAR=test_value"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "test_value\n",
                    "stderr": ""
                }
            },
            "cleanup_commands": [
                "unset TEST_VAR"
            ]
        },
        {
            "tstdin": "",
            "command": "printenv",
            "description": "GNU 选项解析：第一个变量名后的 -0 是变量名而不是 NUL 分隔选项；PRINTENV_ORDER=known，预期输出 known 后换行，因 -0 未定义返回 1。",
            "args": ["PRINTENV_ORDER", "-0"],
            "setup_commands": [
                "export PRINTENV_ORDER=known",
                "unset -v -- -0"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "known\n",
                    "stderr": ""
                }
            },
            "cleanup_commands": [
                "unset PRINTENV_ORDER"
            ]
        },
        {
            "tstdin": "",
            "command": "printenv",
            "description": "GNU 重复短选项：-00 等价于重复指定 -0；PRINTENV_REPEAT=known，预期 RC=0、stdout 完整十六进制=6b6e6f776e00，即 known 后单个 NUL。",
            "args": ["2d3030", "5052494e54454e565f524550454154"],
            "setup_commands": [
                "export PRINTENV_REPEAT=known"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "6b6e6f776e00",
                    "stderr": ""
                }
            },
            "cleanup_commands": [
                "unset PRINTENV_REPEAT"
            ],
            "byteMode": true
        },
        {
            "tstdin": "",
            "command": "printenv",
            "description": "原始字节变量名：LC_ALL=C、LANG=C；-- 后参数完整十六进制=ff5052494e54454e565f4e414d45，对应 \\xffPRINTENV_NAME。变量不存在时 GNU 仅返回 1，stdout 和 stderr 均为 0 字节。",
            "args": ["2d2d", "ff5052494e54454e565f4e414d45"],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": ""
                }
            },
            "environment": {
                "env_vars": {
                    "LC_ALL": "C",
                    "LANG": "C"
                }
            },
            "byteMode": true
        },
        {
            "tstdin": "",
            "command": "printenv",
            "description": "GNU 选项边界：首个变量前的 -a 是未知短选项，预期 RC=2、stdout 为 0 字节。stderr 由通用 clap 诊断层生成，故仅校验退出码和 stdout。",
            "args": ["-a"],
            "expectation": {
                "execution": {
                    "exit_code": 2,
                    "stdout": "",
                    "stderr": ""
                },
                "ignore_fields": {
                    "ignore_stderr": true
                }
            },
            "environment": {
                "env_vars": {
                    "LC_ALL": "C",
                    "LANG": "C"
                }
            }
        },
        {
            "tstdin": "",
            "command": "printenv",
            "description": "显示多个环境变量",
            "args": ["VAR1", "VAR2"],
            "setup_commands": [
                "export VAR1=value1",
                "export VAR2=value2"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "value1\nvalue2\n",
                    "stderr": ""
                }
            },
            "cleanup_commands": [
                "unset VAR1",
                "unset VAR2"
            ]
        },
        {
            "tstdin": "",
            "command": "printenv",
            "description": "使用 -0 参数输出所有环境变量",
            "args": ["-0"],
            "setup_commands": [
                "export TEST_VAR1=test_value1",
                "export TEST_VAR2=test_value2"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout_pattern": ".*TEST_VAR1=test_value1\\0.*TEST_VAR2=test_value2\\0.*",
                    "stderr": ""
                }
            },
            "cleanup_commands": [
                "unset TEST_VAR1",
                "unset TEST_VAR2"
            ]
        },
        {
            "tstdin": "",
            "command": "printenv",
            "description": "使用 --null 参数输出所有环境变量",
            "args": ["--null"],
            "setup_commands": [
                "export TEST_VAR1=test_value1",
                "export TEST_VAR2=test_value2"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout_pattern": ".*TEST_VAR1=test_value1\\0.*TEST_VAR2=test_value2\\0.*",
                    "stderr": ""
                }
            },
            "cleanup_commands": [
                "unset TEST_VAR1",
                "unset TEST_VAR2"
            ]
        },
        {
            "tstdin": "",
            "command": "printenv",
            "description": "使用 -0 参数输出指定环境变量",
            "args": ["-0", "TEST_VAR"],
            "setup_commands": [
                "export TEST_VAR=test_value"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                }
            },
            "cleanup_commands": [
                "unset TEST_VAR"
            ]
        },
        {
            "tstdin": "",
            "command": "printenv",
            "description": "使用 -0 参数输出多个环境变量",
            "args": ["-0", "VAR1", "VAR2"],
            "setup_commands": [
                "export VAR1=value1",
                "export VAR2=value2"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                }
            },
            "cleanup_commands": [
                "unset VAR1",
                "unset VAR2"
            ]
        },
        {
            "tstdin": "",
            "command": "printenv",
            "description": "LC_ALL=C、stdout 连接无读端管道且调用方保留默认 SIGPIPE 时，printenv 输出 PRINTENV_PIPE 的完整输入值 pipe-value 和换行；GNU 在该次写入中由 SIGPIPE 终止，预期 RC=141、stdout 与 stderr 均为 0 字节。",
            "args": ["PRINTENV_PIPE"],
            "environment": {
                "clearEnv": true,
                "env_vars": {
                    "LC_ALL": "C",
                    "LANG": "C",
                    "PRINTENV_PIPE": "pipe-value"
                },
                "standardStreams": {
                    "stdout": "closed_pipe",
                    "sigpipe": "default"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 141,
                    "stdout": "",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "printenv",
            "description": "LC_ALL=C、stdout 连接无读端管道且调用方继承忽略 SIGPIPE 时，printenv 输出 PRINTENV_PIPE 的完整输入值 pipe-value 和换行；GNU 将 EPIPE 报告为 write error，预期 RC=2、stdout 为 0 字节、stderr 完整文本为 printenv: write error: Broken pipe 加换行。",
            "args": ["PRINTENV_PIPE"],
            "environment": {
                "clearEnv": true,
                "env_vars": {
                    "LC_ALL": "C",
                    "LANG": "C",
                    "PRINTENV_PIPE": "pipe-value"
                },
                "standardStreams": {
                    "stdout": "closed_pipe",
                    "sigpipe": "ignore"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 2,
                    "stdout": "",
                    "stderr": "printenv: write error: Broken pipe\n"
                }
            },
            "cleanup_commands": []
        }
    ]
}
