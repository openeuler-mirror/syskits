{
    "tests": [
        {
            "tstdin": "",
            "command": "printf",
            "description": "基本功能测试 - 格式化字符串",
            "args": ["%s\\n", "hello"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "hello\n",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "printf",
            "description": "格式化多个参数",
            "args": ["%s %d\\n", "test", "123"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "test 123\n",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "printf",
            "description": "格式化浮点数",
            "args": ["%.2f\\n", "3.14159"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "3.14\n",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "printf",
            "description": "使用转义序列",
            "args": ["\\t%s\\n", "tabbed"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "\ttabbed\n",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "printf",
            "description": "格式化字符",
            "args": ["%c\\n", "A"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "A\n",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "printf",
            "description": "格式化八进制数",
            "args": ["%o\\n", "10"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "12\n",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "printf",
            "description": "格式化十六进制数",
            "args": ["%x\\n", "255"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "ff\n",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "printf",
            "description": "字段宽度和对齐",
            "args": ["%10s\\n", "right"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "     right\n",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "printf",
            "description": "重复使用格式字符串",
            "args": ["%s\\n", "a", "b", "c"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "a\nb\nc\n",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "printf",
            "description": "无效格式说明符",
            "args": ["%z", "test"],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "printf: invalid format specification '%z'\n"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "printf",
            "description": "使用 -v 选项将输出赋值给变量",
            "setup_commands": [
                "unset VAR"
            ],
            "args": ["-v", "VAR", "%s", "hello"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "environment": {
                    "VAR": "hello"
                }
            },
            "cleanup_commands": [
                "unset VAR"
            ]
        },
        {
            "tstdin": "",
            "command": "printf",
            "description": "使用 %b 扩展反斜杠转义序列",
            "args": ["%b", "hello\\nworld\\t\\t\\t\\n"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "hello\nworld\t\t\t\n",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "printf",
            "description": "使用 %q 引用参数作为shell输入",
            "args": ["%q", "hello world"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "'hello world'\n",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "printf",
            "description": "使用 %q 引用包含特殊字符的参数",
            "args": ["%q", "hello$world"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "'hello$world'\n",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "printf",
            "description": "组合使用 %b 和 %q",
            "args": ["%b %q", "hello\\n", "world"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "hello\n 'world'\n",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "printf",
            "description": "使用 -v 选项和 %b 组合",
            "setup_commands": [
                "unset VAR"
            ],
            "args": ["-v", "VAR", "%b", "hello\\nworld"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "environment": {
                    "VAR": "hello\nworld"
                }
            },
            "cleanup_commands": [
                "unset VAR"
            ]
        },
        {
            "tstdin": "",
            "command": "printf",
            "description": "数值格式0/+标志组合在符号后补零",
            "args": ["%+08.2f", "1.25"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "+0001.25",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "printf",
            "description": "%b中的\\c终止整个输出",
            "args": ["%bX", "a\\cb"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "a",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "printf",
            "description": "C locale中Unicode转义使用ASCII回退表示",
            "setup_commands": [
                "export LC_ALL=C",
                "export LANG=C",
                "export LANGUAGE=C"
            ],
            "args": ["\\u4E2D|\\U0001F600"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "\\u4E2D|\\U0001F600",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "byteMode": true,
            "command": "printf",
            "description": "C locale中Unicode NUL转义输出原始零字节",
            "setup_commands": [
                "export LC_ALL=C",
                "export LANG=C",
                "export LANGUAGE=C"
            ],
            "args": ["5c7530303030"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "00",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "byteMode": true,
            "command": "printf",
            "description": "LC_ALL=C.UTF-8；格式参数字节=252e3173（%.1s），字符串参数字节=c3a9（UTF-8字符é）；预期RC=0，stdout为1字节、内容=c3（按字节精度截断），stderr为0字节、内容=空",
            "setup_commands": [
                "export LC_ALL=C.UTF-8",
                "export LANG=C.UTF-8",
                "export LANGUAGE=C"
            ],
            "args": ["252e3173", "c3a9"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "c3",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "byteMode": true,
            "command": "printf",
            "description": "LC_ALL=C；格式参数字节=2573（%s），字符串参数字节=ff（无效UTF-8单字节）；预期RC=0，stdout为1字节、内容=ff（原样输出Linux参数字节），stderr为0字节、内容=空",
            "setup_commands": [
                "export LC_ALL=C",
                "export LANG=C",
                "export LANGUAGE=C"
            ],
            "args": ["2573", "ff"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "ff",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "printf",
            "description": "LC_ALL=C.UTF-8；执行printf --help x；--help后仍有操作数时作为字面FORMAT；预期RC=0，stdout为6字节、内容=--help，stderr为66字节、提示忽略从x开始的多余参数",
            "setup_commands": [
                "export LC_ALL=C.UTF-8",
                "export LANG=C.UTF-8",
                "export LANGUAGE=C"
            ],
            "args": ["--help", "x"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "--help",
                    "stderr": "printf: warning: ignoring excess arguments, starting with ‘x’\n"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "printf",
            "description": "LC_ALL=C.UTF-8；执行printf --version x；--version后仍有操作数时作为字面FORMAT；预期RC=0，stdout为9字节、内容=--version，stderr为66字节、提示忽略从x开始的多余参数",
            "setup_commands": [
                "export LC_ALL=C.UTF-8",
                "export LANG=C.UTF-8",
                "export LANGUAGE=C"
            ],
            "args": ["--version", "x"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "--version",
                    "stderr": "printf: warning: ignoring excess arguments, starting with ‘x’\n"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "printf",
            "description": "LC_ALL=C；字面FORMAT=literal后跟多余参数a'b；预期RC=0，stdout为7字节、内容=literal，stderr为64字节、使用ASCII单引号并转义参数内单引号",
            "setup_commands": [
                "export LC_ALL=C",
                "export LANG=C",
                "export LANGUAGE=C"
            ],
            "args": ["literal", "a'b"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "literal",
                    "stderr": "printf: warning: ignoring excess arguments, starting with 'a\\'b'\n"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "printf",
            "description": "LC_ALL=C；FORMAT=%q且未提供ARGUMENT；预期RC=0，stdout为0字节、内容=空，stderr为0字节、内容=空；缺失参数不得按显式空字符串输出两个单引号",
            "setup_commands": [
                "export LC_ALL=C",
                "export LANG=C",
                "export LANGUAGE=C"
            ],
            "args": ["%q"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "printf",
            "description": "LC_ALL=C；FORMAT=%d|%u，参数为+3和-1；预期RC=0，stdout为3|18446744073709551615，stderr为空；整数接受前导加号且负数按uintmax_t回绕",
            "setup_commands": [
                "export LC_ALL=C",
                "export LANG=C",
                "export LANGUAGE=C"
            ],
            "args": ["%d|%u", "+3", "-1"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "3|18446744073709551615",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "printf",
            "description": "LC_ALL=C；FORMAT=%d，参数9223372036854775808超出intmax_t范围；预期RC=1，stdout为9223372036854775807，stderr报告Numerical result out of range；溢出时保留strtoimax饱和值",
            "setup_commands": [
                "export LC_ALL=C",
                "export LANG=C",
                "export LANGUAGE=C"
            ],
            "args": ["%d", "9223372036854775808"],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "9223372036854775807",
                    "stderr": "printf: '9223372036854775808': Numerical result out of range\n"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "printf",
            "description": "LC_ALL=C且POSIXLY_CORRECT=1；FORMAT=%d，字符常量参数为'AB；预期RC=0，stdout为65，stderr为空；仅取首字节且POSIX模式抑制尾随字符警告",
            "setup_commands": [
                "export LC_ALL=C",
                "export LANG=C",
                "export LANGUAGE=C",
                "export POSIXLY_CORRECT=1"
            ],
            "args": ["%d", "'AB"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "65",
                    "stderr": ""
                }
            },
            "cleanup_commands": ["unset POSIXLY_CORRECT"]
        },
        {
            "tstdin": "",
            "command": "printf",
            "description": "LC_ALL=C；组合整数FORMAT=%05d|%+5.3d|%#08x|%.0d；预期符号及0x前缀位于补零之前，显式零精度的零值不输出数字",
            "setup_commands": [
                "export LC_ALL=C",
                "export LANG=C",
                "export LANGUAGE=C"
            ],
            "args": ["%05d|%+5.3d|%#08x|%.0d", "-42", "1", "42", "0"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "-0042| +001|0x00002a|",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "printf",
            "description": "LC_ALL=C；FORMAT=%f|%f|%f，参数1e2、0x1p3和infinity；预期RC=0并按GNU strtold语法解析十进制指数、十六进制指数及完整无穷大名称",
            "setup_commands": [
                "export LC_ALL=C",
                "export LANG=C",
                "export LANGUAGE=C"
            ],
            "args": ["%f|%f|%f", "1e2", "0x1p3", "infinity"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "100.000000|8.000000|inf",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "printf",
            "description": "LC_ALL=C；FORMAT=%*d，动态宽度2147483648超过INT_MAX；预期RC=1、stdout为空并报告invalid field width，不得触发内存分配异常",
            "setup_commands": [
                "export LC_ALL=C",
                "export LANG=C",
                "export LANGUAGE=C"
            ],
            "args": ["%*d", "2147483648", "1"],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "printf: invalid field width: '2147483648'\n"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "printf",
            "description": "LC_ALL=C；FORMAT=%.*f，动态精度2147483648超过INT_MAX；预期RC=1、stdout为空并报告invalid precision，不得触发Rust panic",
            "setup_commands": [
                "export LC_ALL=C",
                "export LANG=C",
                "export LANGUAGE=C"
            ],
            "args": ["%.*f", "2147483648", "1"],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "printf: invalid precision: '2147483648'\n"
                }
            },
            "cleanup_commands": []
        }
    ]
}
