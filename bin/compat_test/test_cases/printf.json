{
    "tests": [
        {
            "tstdin": "",
            "command": "printf",
            "description": "基本功能测试 - 格式化字符串",
            "args": ["%s\\n", "hello"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "hello\n",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "printf",
            "description": "格式化多个参数",
            "args": ["%s %d\\n", "test", "123"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "test 123\n",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "printf",
            "description": "格式化浮点数",
            "args": ["%.2f\\n", "3.14159"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "3.14\n",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
