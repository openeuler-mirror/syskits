            "environment": {
                "clearEnv": true,
                "env_vars": {
                    "LC_ALL": "C",
                    "LANG": "C"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "746172676574ff0a",
                    "stderr": ""
                }
            },
            "cleanup_commands": [
                "/usr/bin/rm -f \"$(/usr/bin/printf 'link\\377')\""
            ]
        },
