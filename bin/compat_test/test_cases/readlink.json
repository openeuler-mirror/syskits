        {
            "tstdin": "",
            "command": "readlink",
            "description": "-f必须物理展开目录符号链接后再处理..，不能按逻辑路径提前消除父目录。",
            "setup_commands": [
                "mkdir -p base/dir base/real",
                "ln -s ../real base/dir/link"
            ],
            "args": ["-f", "base/dir/link/.."],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": null,
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "printf '%s' \"$CMD_STDOUT\" | sed 's|.*/||'",
                        "expected_exit": 0,
                        "expected_stdout": "base\n",
                        "expected_stderr": ""
                    }
                ]
            },
            "cleanup_commands": [
                "rm -rf base"
            ]
        },
        {
            "tstdin": "",
            "command": "readlink",
            "description": "LC_ALL=C下默认SIGPIPE且stdout为无读端管道时，GNU readlink在写入链接目标时应由SIGPIPE终止，预期RC=141、stdout和stderr均为空。",
            "setup_commands": [
                "/usr/bin/ln -s target link"
            ],
            "args": ["link"],
            "environment": {
                "env_vars": {
                    "LC_ALL": "C",
                    "LANG": "C"
                },
                "standardStreams": {
                    "stdout": "closed_pipe",
                    "sigpipe": "default",
                    "useBash": true
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 141,
                    "stdout": "",
                    "stderr": ""
                }
            },
            "cleanup_commands": [
                "/usr/bin/rm -f link"
            ]
        },
