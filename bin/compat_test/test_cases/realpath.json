                    "stderr": "realpath: a/loop1: Too many levels of symbolic links\n"
                }
            },
            "cleanup_commands": [
                "rm -rf a"
            ]
        },
        {
            "tstdin": "",
            "command": "realpath",
            "description": "执行realpath -s a/file/；默认模式仍要求尾随斜杠对象为目录，普通文件file不满足要求，预期RC=1、stdout为空、stderr报告Not a directory。",
            "setup_commands": [
                "mkdir a",
