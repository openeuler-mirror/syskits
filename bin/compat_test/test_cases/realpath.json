                "execution": {
                    "exit_code": 0,
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "test \"$CMD_STDOUT\" = \"$(pwd)/directory/missing\"",
                        "expected_exit": 0
                    }
                ]
            },
            "cleanup_commands": []
        },
