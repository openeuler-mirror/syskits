        {
            "tstdin": "",
            "command": "realpath",
            "description": "原始字节路径用例：LC_ALL=C、LANG=C；执行 realpath --relative-to=base-\\xff base-\\xff/child-\\xff；参数完整十六进制为2d2d72656c61746976652d746f3d626173652dff和626173652dff2f6368696c642dff；stdin为0字节；创建两个含0xff的路径组件后，预期RC=0、stderr为0字节、stdout完整十六进制为6368696c642dff0a，即相对路径child-\\xff后接换行。",
            "args": [
                "2d2d72656c61746976652d746f3d626173652dff",
                "626173652dff2f6368696c642dff"
            ],
            "setup_commands": [
                "export LC_ALL='C'",
                "export LANG='C'",
                "base=$(printf 'base-\\377'); mkdir -p -- \"$base\"; : > \"$base/child-$(printf '\\377')\""
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "6368696c642dff0a",
                    "stderr": ""
                }
            },
            "cleanup_commands": [
                "rm -rf -- \"$(printf 'base-\\377')\""
            ],
            "byteMode": true
        },
        {
            "tstdin": "",
            "command": "realpath",
            "description": "POSIXLY_CORRECT=1时执行realpath a -m missing；GNU getopt在首个路径a后停止解析，-m和missing均为路径；创建a后预期RC=0、stderr为空，stdout依次为a、-m、missing的三个绝对路径。",
            "setup_commands": [
                "touch a"
            ],
            "args": [
                "a",
                "-m",
                "missing"
            ],
            "environment": {
                "env_vars": {
                    "POSIXLY_CORRECT": "1"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "test \"$(printf '%s\\n' \"$CMD_STDOUT\" | sed -n '1p')\" = \"$PWD/a\"",
                        "expected_exit": 0,
                        "expected_stdout": ""
                    },
                    {
                        "command": "test \"$(printf '%s\\n' \"$CMD_STDOUT\" | sed -n '2p')\" = \"$PWD/-m\"",
                        "expected_exit": 0,
                        "expected_stdout": ""
                    },
                    {
                        "command": "test \"$(printf '%s\\n' \"$CMD_STDOUT\" | sed -n '3p')\" = \"$PWD/missing\"",
                        "expected_exit": 0,
                        "expected_stdout": ""
                    }
                ]
            },
            "cleanup_commands": [
                "rm -f -- a -m missing"
            ]
        },
        {
            "tstdin": "",
            "command": "realpath",
            "description": "quiet模式执行realpath -q -e missing；所有组件必须存在时missing解析失败，GNU抑制诊断但仍返回RC=1，预期stdout和stderr均为空。",
            "args": [
                "-q",
                "-e",
                "missing"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
