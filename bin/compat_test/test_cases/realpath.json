            },
            "cleanup_commands": [
                "rm -rf d"
            ]
        },
        {
            "tstdin": "",
            "command": "realpath",
            "description": "nobody执行realpath directory/missing；directory仅有搜索权限0111时，最终缺失分量仍应按GNU成功解析，不能要求目录可读。",
            "args": [
                "directory/missing"
            ],
            "environment": {
                "files": [
                    {
                        "path": "directory",
                        "content": null,
                        "permissions": "111",
                        "owner": null,
                        "group": null,
                        "file_type": "Directory",
                        "symlink_target": null,
                        "size": null,
                        "timestamp": null
