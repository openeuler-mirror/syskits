        {
            "tstdin": "",
            "command": "realpath",
            "description": "-s -e必须按未展开符号链接的词法路径校验最终分量；linkdir/../b中的词法b不存在时应失败，不能因linkdir物理指向d/a而接受d/b。",
            "setup_commands": [
                "mkdir -p d/a d/b",
                "ln -s d/a linkdir"
            ],
            "args": [
                "-s",
                "-e",
                "linkdir/../b"
            ],
            "environment": {
                "env_vars": {
                    "LC_ALL": "C",
                    "LANG": "C"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "realpath: linkdir/../b: No such file or directory\n"
                }
            },
            "cleanup_commands": [
                "rm -rf d linkdir"
            ]
        },
        {
            "tstdin": "",
            "command": "realpath",
            "description": "-s -e不允许默认模式的末级缺失豁免；d/missing/要求missing为目录，缺失时应返回No such file or directory。",
