        {
            "tstdin": "",
            "command": "realpath",
            "description": "执行realpath -s a/loop1；即使不展开输出中的链接，GNU仍拒绝符号链接循环，预期RC=1、stdout为空、stderr报告Too many levels of symbolic links。",
            "setup_commands": [
                "mkdir a",
