            ],
            "args": [
                "-s",
                "a/file/"
            ],
            "environment": {
                "env_vars": {
                    "LC_ALL": "C",
                    "LANG": "C"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "realpath: a/file/: Not a directory\n"
                }
            },
            "cleanup_commands": [
                "rm -rf a"
            ]
        }
    ]
