{
    "tests": [
        {
            "tstdin": "",
            "command": "realpath",
            "description": "不传FILE操作数时，realpath应按GNU报告missing operand并返回1，而不是输出clap的必填参数诊断。",
            "args": [],
            "environment": {
                "env_vars": {
                    "LC_ALL": "C",
                    "LANG": "C"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "realpath: missing operand\nTry 'realpath --help' for more information.\n"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "realpath",
            "description": "GNU realpath没有-h短帮助选项；-h必须作为无效短选项返回1，不能显示帮助并成功退出。",
            "args": [
                "-h"
            ],
            "environment": {
                "env_vars": {
                    "LC_ALL": "C",
                    "LANG": "C"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "realpath: invalid option -- 'h'\nTry 'realpath --help' for more information.\n"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
