{
    "tests": [
        {
            "tstdin": "",
            "command": "realpath",
            "description": "执行realpath -m a/loop1；canonicalize-missing允许符号链接循环作为缺失路径处理，预期输出字面规范化路径并返回0。",
            "setup_commands": [
                "mkdir a",
                "ln -s loop2 a/loop1",
                "ln -s loop1 a/loop2"
            ],
            "args": [
                "-m",
                "a/loop1"
            ],
            "environment": {
                "env_vars": {
                    "LC_ALL": "C",
                    "LANG": "C"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "test \"$CMD_STDOUT\" = \"$(pwd)/a/loop1\"",
                        "expected_exit": 0
                    }
                ]
            },
            "cleanup_commands": [
                "rm -rf a"
            ]
        },
        {
            "tstdin": "",
            "command": "realpath",
            "description": "基本路径解析",
            "setup_commands": [
                "mkdir -p testdir",
                "echo 'test' > testdir/file.txt"
            ],
            "args": [
                "testdir/file.txt"
            ],
            "cleanup_commands": [
                "rm -rf testdir"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0
                },
                "verifications": [
                    {
                        "command": "echo \"$CMD_STDOUT\" | grep -q '^/.*testdir/file.txt$'",
                        "expected_exit": 0
                    }
                ]
            }
        },
        {
            "tstdin": "",
            "command": "realpath",
            "description": "符号链接解析",
            "setup_commands": [
                "mkdir -p testdir",
                "echo 'test' > testdir/file.txt",
                "ln -s testdir/file.txt symlink.txt"
            ],
            "args": [
                "symlink.txt"
            ],
            "cleanup_commands": [
                "rm -f symlink.txt",
                "rm -rf testdir"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0
                },
                "verifications": [
                    {
                        "command": "echo \"$CMD_STDOUT\" | grep -q '^/.*testdir/file.txt$'",
                        "expected_exit": 0
                    }
                ]
            }
        },
        {
            "tstdin": "",
            "command": "realpath",
            "description": "不存在路径(-e)",
            "args": [
                "-e",
                "nonexistent"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stderr": "No such file or directory"
                }
            }
        },
        {
            "tstdin": "",
            "command": "realpath",
            "description": "强制解析不存在路径(-m)",
            "args": [
                "-m",
                "nonexistent/../path"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0
                },
                "verifications": [
                    {
                        "command": "echo \"$CMD_STDOUT\" | grep -q '^/.*/path$'",
                        "expected_exit": 0
                    }
                ]
            }
        },
