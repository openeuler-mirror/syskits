{
    "tests": [
        {
            "tstdin": "",
            "command": "rmdir",
            "description": "基本功能测试",
            "setup_commands": [
                "mkdir test_dir"
            ],
            "args": ["test_dir"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "rmdir",
            "description": "删除多个目录",
            "setup_commands": [
                "mkdir dir1 dir2 dir3"
            ],
            "args": ["dir1", "dir2", "dir3"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "rmdir",
            "description": "递归删除父目录",
            "setup_commands": [
                "mkdir -p a/b/c"
            ],
            "args": ["-p", "a/b/c"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "rmdir",
            "description": "删除非空目录测试",
            "setup_commands": [
                "mkdir test_dir",
                "touch test_dir/file"
            ],
            "args": ["test_dir"],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "rmdir: failed to remove 'test_dir': Directory not empty\n"
                }
            },
            "cleanup_commands": [
                "rm -rf test_dir"
            ]
        },
        {
            "tstdin": "",
            "command": "rmdir",
            "description": "目录不存在测试",
            "args": ["nonexistent_dir"],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "rmdir: failed to remove 'nonexistent_dir': No such file or directory\n"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "rmdir",
            "description": "删除文件测试",
            "setup_commands": [
                "touch test_file"
            ],
            "args": ["test_file"],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "rmdir: failed to remove 'test_file': Not a directory\n"
                }
            },
            "cleanup_commands": [
                "rm -f test_file"
            ]
        },
        {
            "tstdin": "",
            "command": "rmdir",
            "description": "详细输出测试",
            "setup_commands": [
                "mkdir verbose_dir"
            ],
            "args": ["-v", "verbose_dir"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "rmdir: removing directory, 'verbose_dir'\n",
                    "stderr": ""
                },
                "ignore_fields": {
                  "ignore_stdout": true
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "rmdir",
            "description": "使用 --ignore-fail-on-non-empty 选项删除非空目录",
            "setup_commands": [
                "mkdir test_dir",
                "touch test_dir/file"
            ],
            "args": ["--ignore-fail-on-non-empty", "test_dir"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "test -d test_dir && echo 'directory still exists'",
                        "expected_exit": 0,
                        "expected_stdout": "directory still exists"
                    }
                ]
            },
            "cleanup_commands": [
                "rm -rf test_dir"
            ]
        },
        {
            "tstdin": "",
            "command": "rmdir",
            "description": "使用 --ignore-fail-on-non-empty 选项删除多个目录（部分非空）",
            "setup_commands": [
                "mkdir dir1 dir2 dir3",
                "touch dir2/file"
            ],
            "args": ["--ignore-fail-on-non-empty", "dir1", "dir2", "dir3"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "test ! -d dir1 && test -d dir2 && test ! -d dir3 && echo 'mixed result'",
                        "expected_exit": 0,
                        "expected_stdout": "mixed result"
                    }
                ]
            },
            "cleanup_commands": [
                "rm -rf dir1 dir2 dir3"
            ]
        },
        {
            "tstdin": "",
            "command": "rmdir",
            "description": "使用 --ignore-fail-on-non-empty 选项和 -p 选项组合",
            "setup_commands": [
                "mkdir -p a/b/c",
                "touch a/b/file"
            ],
            "args": ["-p", "--ignore-fail-on-non-empty", "a/b/c"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "test -d a/b && test ! -d a/b/c && echo 'partial removal'",
                        "expected_exit": 0,
                        "expected_stdout": "partial removal"
                    }
                ]
            },
            "cleanup_commands": [
                "rm -rf a"
            ]
        },
        {
            "tstdin": "",
            "command": "rmdir",
            "description": "兼容已弃用的 --path 父目录删除别名",
            "setup_commands": [
                "mkdir -p a/b"
            ],
            "args": ["--path", "a/b"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "test ! -e a && echo 'parents removed'",
                        "expected_exit": 0,
                        "expected_stdout": "parents removed"
                    }
                ]
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "rmdir",
            "description": "重复 -p 仍递归删除父目录",
            "setup_commands": [
                "mkdir -p a/b"
            ],
            "args": ["-p", "-p", "a/b"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "test ! -e a && echo 'parents removed'",
                        "expected_exit": 0,
                        "expected_stdout": "parents removed"
                    }
                ]
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "rmdir",
            "description": "重复详细输出开关只输出一次操作诊断",
            "setup_commands": [
                "mkdir verbose_dir"
            ],
            "args": ["-v", "--verbose", "verbose_dir"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "rmdir: removing directory, 'verbose_dir'\n",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "rmdir",
            "description": "重复非空失败忽略开关保持成功",
            "setup_commands": [
                "mkdir nonempty_dir",
                "touch nonempty_dir/file"
            ],
            "args": ["--ignore-fail-on-non-empty", "--ignore-fail-on-non-empty", "nonempty_dir"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "test -d nonempty_dir && echo 'directory retained'",
                        "expected_exit": 0,
                        "expected_stdout": "directory retained"
                    }
                ]
            },
            "cleanup_commands": [
                "rm -rf nonempty_dir"
            ]
        },
        {
            "tstdin": "",
            "command": "rmdir",
            "description": "父目录非空时使用 GNU 阶段化错误诊断",
            "setup_commands": [
                "mkdir -p a/b",
                "touch a/keep"
            ],
            "args": ["-p", "a/b"],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "rmdir: failed to remove directory 'a': Directory not empty\n"
                },
                "verifications": [
                    {
                        "command": "test ! -e a/b && test -d a && echo 'child removed'",
                        "expected_exit": 0,
                        "expected_stdout": "child removed"
                    }
                ]
            },
            "cleanup_commands": [
                "rm -rf a"
            ]
        },
        {
            "tstdin": "",
            "command": "rmdir",
            "description": "POSIXLY_CORRECT 在首个目录后停止解析选项",
            "setup_commands": [
                "mkdir a"
            ],
            "args": ["a", "-v"],
            "environment": {
                "env_vars": {
                    "POSIXLY_CORRECT": "1"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "rmdir: failed to remove '-v': No such file or directory\n"
                },
                "verifications": [
                    {
                        "command": "test ! -e a && echo 'first operand removed'",
                        "expected_exit": 0,
                        "expected_stdout": "first operand removed"
                    }
                ]
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "byteMode": true,
            "command": "rmdir",
            "description": "原始字节错误用例：LC_ALL=C 下对普通文件路径 bad\\377 执行 rmdir；参数完整十六进制=626164ff，GNU quoteaf 应将有效文本和 0xff 分段为 'bad'$'\\377'，预期 RC=1、stdout为空、stderr完整十六进制保留八进制转义。",
            "setup_commands": [
                "name=$(printf 'bad\\377'); printf x > \"$name\""
            ],
            "args": ["626164ff"],
            "environment": {
                "env_vars": {
                    "LC_ALL": "C"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "726d6469723a206661696c656420746f2072656d6f766520276261642724275c333737273a204e6f742061206469726563746f72790a"
                }
            },
            "cleanup_commands": [
                "name=$(printf 'bad\\377'); rm -f -- \"$name\""
            ]
        }
    ]
}
