                "1-5",
                "--random-source",
                "rand_src"
            ],
            "setup_commands": [
                "dd if=/dev/urandom of=rand_src bs=1024 count=1 2>/dev/null"
            ],
            "cleanup_commands": [
                "rm -f rand_src"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
