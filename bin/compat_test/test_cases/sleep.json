{
    "tests": [
        {
            "tstdin": "",
            "command": "sleep",
            "description": "sleep: 基本睡眠 0.001 秒",
            "args": [
                "0.001"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0
                }
            }
        },
        {
            "tstdin": "",
            "command": "sleep",
            "description": "sleep: 睡眠 0 秒",
            "args": [
                "0"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0
                }
            }
        },
        {
            "tstdin": "",
            "command": "sleep",
            "description": "sleep: 后缀 s (秒)",
            "args": [
                "0.001s"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0
                }
            }
        },
        {
            "tstdin": "",
            "command": "sleep",
            "description": "sleep: 后缀 m (分钟)",
            "args": [
                "0.001m"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0
                }
            }
        },
        {
            "tstdin": "",
            "command": "sleep",
            "description": "sleep: 后缀 h (小时)",
            "args": [
                "0.001h"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0
                }
            }
        },
        {
            "tstdin": "",
            "command": "sleep",
            "description": "sleep: 后缀 d (天)",
            "args": [
                "0.00001d"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0
                }
            }
        },
        {
            "tstdin": "",
            "command": "sleep",
            "description": "sleep: 多参数累加 - 浮点数",
            "args": [
                "0.001",
                "0.002",
                "0.003"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0
                }
            }
        },
        {
            "tstdin": "",
            "command": "sleep",
            "description": "sleep: 多参数累加 - 混合后缀",
            "args": [
                "0.001s",
                "0.001m",
                "0.001h"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0
                }
            }
        },
        {
            "tstdin": "",
            "command": "sleep",
            "description": "sleep: 无效输入",
            "args": [
                "invalid"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 1
                }
            }
        },
        {
            "tstdin": "",
            "command": "sleep",
            "description": "sleep: 负数",
            "args": [
                "--",
                "-1"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 1
                }
            }
        },
        {
            "tstdin": "",
            "command": "sleep",
            "description": "sleep: 大写后缀 D",
            "args": [
                "42D"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 1
                }
            }
        },
        {
            "tstdin": "",
            "command": "sleep",
            "description": "sleep: 无效后缀 day",
            "args": [
                "42d",
                "42day"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 1
                }
            }
        },
        {
            "tstdin": "",
            "command": "sleep",
            "description": "sleep: NaN 值",
            "args": [
                "nan"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 1
                }
            }
        },
        {
            "tstdin": "",
            "command": "sleep",
            "description": "sleep: 空字符串",
            "args": [
                ""
            ],
            "expectation": {
                "execution": {
                    "exit_code": 1
                }
            }
        },
        {
            "tstdin": "",
            "command": "sleep",
            "description": "sleep: 缺少参数",
            "args": [],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "sleep: missing operand\nTry 'sleep --help' for more information.\n"
                }
            }
        },
        {
            "tstdin": "",
            "command": "sleep",
            "description": "sleep: 多个参数其中一个无效",
            "args": [
                "0.001",
                "invalid"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 1
                }
            }
        },
        {
            "tstdin": "",
            "command": "sleep",
            "description": "sleep: 整数和浮点数混合",
            "args": [
                "1",
                "0.5"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0
                }
            }
        },
        {
            "tstdin": "",
            "command": "sleep",
            "description": "sleep: 非常小的数值",
            "args": [
                "0.0001"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0
                }
            }
        },
        {
            "tstdin": "",
            "command": "sleep",
            "description": "sleep: 十六进制浮点数可使用秒后缀",
            "args": [
                "0x.002p1s"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0
                }
            }
        },
        {
            "tstdin": "",
            "command": "sleep",
            "description": "sleep: 拒绝没有十六进制尾数的时间间隔",
            "args": [
                "0x.p0"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 1
                }
            }
        },
        {
            "tstdin": "",
            "command": "sleep",
            "description": "sleep: 允许前导空白但拒绝数值后的空白",
            "args": [
                "0 "
            ],
            "expectation": {
                "execution": {
                    "exit_code": 1
                }
            }
        },
        {
            "tstdin": "",
            "command": "sleep",
            "description": "sleep: 不接受 GNU 未定义的短帮助选项",
            "args": [
                "-h"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "sleep: invalid option -- 'h'\nTry 'sleep --help' for more information.\n"
                }
            }
        },
        {
            "tstdin": "",
            "command": "sleep",
            "description": "sleep: 不接受 GNU 未定义的短版本选项",
            "args": [
                "-V"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 1
                }
            }
        },
        {
            "tstdin": "",
            "command": "sleep",
            "description": "sleep: 单独的选项结束符视为零个时长",
            "args": [
                "--"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0
                }
            }
        },
        {
            "tstdin": "",
            "command": "sleep",
            "description": "sleep: 使用当前 locale 的逗号小数点并回退兼容点号",
            "args": [
                "0,0"
            ],
            "setup_commands": [
                "export LC_ALL='en_DK.utf8'",
                "export LANG='en_DK.utf8'"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                }
            }
        },
        {
            "tstdin": "",
            "command": "sleep",
            "description": "sleep: 多个亚纳秒时长按总和向上取整",
            "args": [
                "0.0000000006",
                "0.0000000006"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                }
            }
        },
        {
            "tstdin": "",
            "command": "sleep",
            "description": "sleep: POSIXLY_CORRECT 下首个时长后的选项作为时长参数",
            "args": [
                "0",
                "--help"
            ],
            "setup_commands": [
                "export POSIXLY_CORRECT=1"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 1
                }
            }
        },
        {
            "tstdin": "",
            "command": "sleep",
            "description": "sleep: UTF-8 locale 使用 GNU 诊断引号",
            "args": [
                "invalid"
            ],
            "setup_commands": [
                "export LC_ALL='C.utf8'",
                "export LANG='C.utf8'"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "sleep: invalid time interval ‘invalid’\nTry 'sleep --help' for more information.\n"
                }
            }
        },
        {
            "command": "sleep",
            "description": "原始字节用例：export LC_ALL='C'，export LANG='C'；执行 sleep <0xff>；参数完整十六进制=ff；stdin为0字节、完整十六进制=空；输入fixture：无文件fixture；预期RC=1，stdout为0字节、完整十六进制=空，stderr为86字节、完整十六进制=736c6565703a20696e76616c69642074696d6520696e74657276616c20275c333737270a5472792027736c656570202d2d68656c702720666f72206d6f726520696e666f726d6174696f6e2e0a。",
            "args": [
                "ff"
            ],
            "setup_commands": [
                "export LC_ALL='C'",
                "export LANG='C'"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "736c6565703a20696e76616c69642074696d6520696e74657276616c20275c333737270a5472792027736c656570202d2d68656c702720666f72206d6f726520696e666f726d6174696f6e2e0a"
                }
            },
            "cleanup_commands": [],
            "tstdin": "",
            "byteMode": true
        }
    ]
}
