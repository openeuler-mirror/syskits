{
    "tests": [
        {
            "tstdin": "",
            "command": "sort",
            "description": "基本功能测试 - 默认排序",
            "setup_commands": [
                "echo -e 'c\nb\na' > test.txt"
            ],
            "args": ["test.txt"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "a\nb\nc\n",
                    "stderr": ""
                }
            },
            "cleanup_commands": [
                "rm -f test.txt"
            ]
        },
        {
            "tstdin": "",
            "command": "sort",
            "description": "测试 -r 选项 - 逆序排序",
            "setup_commands": [
                "echo -e 'a\nb\nc' > test.txt"
            ],
            "args": ["-r", "test.txt"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "c\nb\na\n",
                    "stderr": ""
                }
            },
            "cleanup_commands": [
                "rm -f test.txt"
            ]
        },
        {
            "tstdin": "",
