            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "Jan\nFeb\nMar\nDec\n",
                    "stderr": ""
                },
                "ignore_fields": {
                    "ignore_stdout": true,
                    "ignore_stderr": true
                }
            },
            "cleanup_commands": [
                "rm -f test.txt"
            ]
        },
