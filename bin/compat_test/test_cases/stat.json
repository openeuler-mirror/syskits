        },
        {
            "tstdin": "",
            "command": "stat",
            "description": "LC_ALL=C；重复-L、-f、-t、-c和--cached选项；GNU接受重复选项并采用最后一个带值选项，预期RC=0、stdout为/tmp和换行、stderr为空",
            "setup_commands": [
                "export LC_ALL='C'"
            ],
            "args": [
                "-L",
                "-L",
                "-f",
                "-f",
                "-t",
                "-t",
                "-c",
                "first",
                "-c",
                "%n",
                "--cached=always",
                "--cached=never",
                "/tmp"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "/tmp\n",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "stat",
            "description": "LC_ALL=C；先指定--printf=first再指定--format=second；最后的--format生效并追加换行，预期RC=0、stdout完整内容为second和换行、stderr为空",
            "setup_commands": [
                "export LC_ALL='C'",
                "touch format_order_file"
            ],
            "args": [
                "--printf=first",
                "--format=second",
                "format_order_file"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "second\n",
                    "stderr": ""
                }
            },
            "cleanup_commands": [
                "rm -f format_order_file"
            ]
        },
        {
            "tstdin": "",
            "command": "stat",
            "description": "LC_ALL=C；先指定--format=first再指定--printf=second；最后的--printf生效且不追加换行，预期RC=0、stdout完整内容为second、stderr为空",
            "setup_commands": [
                "export LC_ALL='C'",
                "touch printf_order_file"
            ],
            "args": [
                "--format=first",
                "--printf=second",
                "printf_order_file"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "second",
                    "stderr": ""
                }
            },
            "cleanup_commands": [
                "rm -f printf_order_file"
            ]
        },
        {
            "tstdin": "",
            "command": "stat",
            "description": "LC_ALL=C；显式指定空的-c格式；空格式仍是用户格式并自动追加换行，预期RC=0、stdout完整内容为一个换行、stderr为空",
            "setup_commands": [
                "export LC_ALL='C'",
                "touch empty_format_file"
            ],
            "args": [
                "-c",
                "",
                "empty_format_file"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "\n",
                    "stderr": ""
                }
            },
            "cleanup_commands": [
                "rm -f empty_format_file"
            ]
        },
        {
            "tstdin": "",
            "command": "stat",
            "description": "LC_ALL=C；显式指定空的--printf格式；空格式不输出默认状态且不追加换行，预期RC=0、stdout和stderr均为空",
            "setup_commands": [
                "export LC_ALL='C'",
                "touch empty_printf_file"
            ],
            "args": [
                "--printf=",
                "empty_printf_file"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                }
            },
            "cleanup_commands": [
                "rm -f empty_printf_file"
            ]
        }
    ]
}
