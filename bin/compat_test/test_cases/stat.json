        {
            "tstdin": "",
            "command": "stat",
            "description": "LC_ALL=C；重复-L、-f、-t、-c和--cached选项；GNU接受重复选项并采用最后一个带值选项，预期RC=0、stdout为/tmp和换行、stderr为空",
            "setup_commands": [
                "export LC_ALL='C'"
            ],
            "args": [
                "-L",
                "-L",
                "-f",
                "-f",
                "-t",
                "-t",
                "-c",
                "first",
                "-c",
                "%n",
                "--cached=always",
                "--cached=never",
                "/tmp"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "/tmp\n",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "stat",
            "description": "LC_ALL=C；先指定--printf=first再指定--format=second；最后的--format生效并追加换行，预期RC=0、stdout完整内容为second和换行、stderr为空",
            "setup_commands": [
                "export LC_ALL='C'",
                "touch format_order_file"
            ],
            "args": [
                "--printf=first",
                "--format=second",
                "format_order_file"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "second\n",
                    "stderr": ""
                }
            },
            "cleanup_commands": [
                "rm -f format_order_file"
            ]
        },
