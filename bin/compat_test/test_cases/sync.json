{
  "tests": [
    {
      "command": "sync",
      "description": "无参数调用 - 同步所有文件系统",
      "args": [],
      "expectation": {
        "execution": {
          "exit_code": 0,
          "stdout": "",
          "stderr": ""
        }
      }
    },
    {
      "command": "sync",
      "description": "同步单个文件 (fsync)",
      "args": ["test_file"],
      "setup_commands": [
        "touch test_file"
      ],
      "expectation": {
        "execution": {
          "exit_code": 0,
          "stdout": "",
          "stderr": ""
        }
      },
      "cleanup_commands": [
        "rm -f test_file"
      ]
    },
    {
      "command": "sync",
      "description": "-f 选项 - 同步文件系统",
      "args": ["-f", "test_file"],
      "setup_commands": [
        "touch test_file"
      ],
      "expectation": {
        "execution": {
          "exit_code": 0,
          "stdout": "",
          "stderr": ""
        }
      },
      "cleanup_commands": [
        "rm -f test_file"
      ]
    },
    {
      "command": "sync",
      "description": "--file-system 长选项 - 同步文件系统",
      "args": ["--file-system", "test_file"],
      "setup_commands": [
        "touch test_file"
      ],
      "expectation": {
        "execution": {
          "exit_code": 0,
          "stdout": "",
          "stderr": ""
        }
      },
      "cleanup_commands": [
        "rm -f test_file"
      ]
    },
    {
      "command": "sync",
      "description": "-d 选项 - 仅同步数据 (fdatasync)",
      "args": ["-d", "test_file"],
      "setup_commands": [
        "touch test_file"
      ],
      "expectation": {
        "execution": {
          "exit_code": 0,
          "stdout": "",
          "stderr": ""
        }
      },
      "cleanup_commands": [
        "rm -f test_file"
      ]
    },
    {
      "command": "sync",
      "description": "--data 长选项 - 仅同步数据",
      "args": ["--data", "test_file"],
      "setup_commands": [
        "touch test_file"
      ],
      "expectation": {
        "execution": {
          "exit_code": 0,
          "stdout": "",
          "stderr": ""
        }
      },
      "cleanup_commands": [
        "rm -f test_file"
      ]
    },
    {
      "command": "sync",
      "description": "-d 选项无参数 - 应失败",
      "args": ["-d"],
      "expectation": {
        "execution": {
          "exit_code": 1,
          "stdout": null,
          "stderr": null
        },
        "ignore_fields": {
          "ignore_stdout": true,
          "ignore_stderr": true
        }
      }
    },
    {
      "command": "sync",
      "description": "--data 选项无参数 - 应失败",
      "args": ["--data"],
      "expectation": {
        "execution": {
          "exit_code": 1,
          "stdout": null,
          "stderr": null
        },
        "ignore_fields": {
          "ignore_stdout": true,
          "ignore_stderr": true
        }
      }
    },
    {
      "command": "sync",
      "description": "GNU 无参长选项附带值：--data=value 必须以 GNU 文案拒绝参数。",
      "args": ["--data=value"],
      "expectation": {
        "execution": {
          "exit_code": 1,
          "stdout": "",
          "stderr": "sync: option '--data' doesn't allow an argument\nTry 'sync --help' for more information.\n"
        }
      },
      "environment": {
        "env_vars": {
          "LC_ALL": "C",
          "LANG": "C"
        }
      }
    },
    {
      "command": "sync",
      "description": "GNU 短选项组扫描：-dfile 在识别 -d 和 -f 后必须报告首个非法选项 i。",
      "args": ["-dfile"],
      "expectation": {
        "execution": {
          "exit_code": 1,
          "stdout": "",
          "stderr": "sync: invalid option -- 'i'\nTry 'sync --help' for more information.\n"
        }
      },
      "environment": {
        "env_vars": {
          "LC_ALL": "C",
          "LANG": "C"
        }
      }
    },
    {
      "command": "sync",
      "description": "GNU 未知长选项：--unknown 必须输出 unrecognized option 诊断。",
      "args": ["--unknown"],
      "expectation": {
        "execution": {
          "exit_code": 1,
          "stdout": "",
          "stderr": "sync: unrecognized option '--unknown'\nTry 'sync --help' for more information.\n"
        }
      },
      "environment": {
        "env_vars": {
          "LC_ALL": "C",
          "LANG": "C"
        }
      }
    },
    {
      "command": "sync",
      "description": "-d 和 -f 互斥 - 应失败",
      "args": ["--data", "--file-system"],
      "expectation": {
        "execution": {
          "exit_code": 1,
          "stdout": null,
          "stderr": null
        },
        "ignore_fields": {
          "ignore_stdout": true,
          "ignore_stderr": true
        }
      }
    },
    {
      "command": "sync",
      "description": "同步不存在的文件 - 应失败",
      "args": ["nonexistent_file"],
      "expectation": {
        "execution": {
          "exit_code": 1,
          "stdout": "",
          "stderr": null
        },
        "ignore_fields": {
          "ignore_stderr": true
        }
      }
    },
    {
      "command": "sync",
      "description": "多文件 - 包含不存在的文件",
      "args": ["test_file", "nonexistent_file"],
      "setup_commands": [
        "touch test_file"
      ],
      "expectation": {
        "execution": {
          "exit_code": 1,
          "stdout": "",
          "stderr": null
        },
        "ignore_fields": {
          "ignore_stderr": true
        }
      },
      "cleanup_commands": [
        "rm -f test_file"
      ]
    },
    {
      "command": "sync",
      "description": "首个文件不存在且后续文件有效时，sync 仍必须尝试同步后续文件，并以失败状态退出。",
      "args": ["missing_first", "valid_after_error"],
      "setup_commands": [
        "printf data > valid_after_error"
      ],
      "expectation": {
        "execution": {
          "exit_code": 1,
          "stdout": "",
          "stderr": null
        },
        "ignore_fields": {
          "ignore_stderr": true
        }
      },
      "cleanup_commands": [
        "rm -f valid_after_error"
      ]
    },
    {
      "command": "sync",
      "description": "多个文件同步失败时，按输入顺序输出每个文件的打开错误并以状态 1 退出。",
      "args": ["missing_one", "missing_two"],
      "expectation": {
        "execution": {
          "exit_code": 1,
          "stdout": "",
          "stderr": "sync: error opening 'missing_one': No such file or directory\nsync: error opening 'missing_two': No such file or directory\n"
        }
      },
      "cleanup_commands": []
    },
    {
      "command": "sync",
      "description": "POSIXLY_CORRECT=1 时首个文件后的 -d 按文件名处理，先同步已有文件再报告 -d 不存在。",
      "args": ["valid", "-d"],
      "setup_commands": [
        "export POSIXLY_CORRECT=1",
        "printf data > valid"
      ],
      "expectation": {
        "execution": {
          "exit_code": 1,
          "stdout": "",
          "stderr": "sync: error opening '-d': No such file or directory\n"
        }
      },
      "cleanup_commands": [
        "rm -f valid"
      ]
    },
    {
      "command": "sync",
      "description": "同步目录",
      "args": ["test_dir"],
      "setup_commands": [
        "mkdir -p test_dir"
      ],
      "expectation": {
        "execution": {
          "exit_code": 0,
          "stdout": "",
          "stderr": ""
        }
      },
      "cleanup_commands": [
        "rm -rf test_dir"
      ]
    },
    {
      "command": "sync",
      "description": "Linux 对 /dev/null 执行 fsync 返回 EINVAL；预期状态 1、stdout 为空，stderr 使用 GNU errno 文本 Invalid argument。",
      "args": ["/dev/null"],
      "expectation": {
        "execution": {
          "exit_code": 1,
          "stdout": "",
          "stderr": "sync: error syncing '/dev/null': Invalid argument\n"
        }
      }
    },
    {
      "command": "sync",
      "description": "-f 选项无文件参数 - 应成功（等效于 sync）",
      "args": ["-f"],
      "expectation": {
        "execution": {
          "exit_code": 0,
          "stdout": "",
          "stderr": ""
        }
      }
    },
    {
      "command": "sync",
      "description": "--file-system 选项无文件参数 - 应成功",
      "args": ["--file-system"],
      "expectation": {
        "execution": {
          "exit_code": 0,
          "stdout": "",
          "stderr": ""
        }
      }
    },
    {
      "command": "sync",
      "description": "同步多个文件",
      "args": ["test_file1", "test_file2"],
      "setup_commands": [
        "touch test_file1",
        "touch test_file2"
      ],
      "expectation": {
        "execution": {
          "exit_code": 0,
          "stdout": "",
          "stderr": ""
        }
      },
      "cleanup_commands": [
        "rm -f test_file1 test_file2"
      ]
    },
    {
      "command": "sync",
      "description": "-d 选项同步多个文件",
      "args": ["-d", "test_file1", "test_file2"],
      "setup_commands": [
        "touch test_file1",
        "touch test_file2"
      ],
      "expectation": {
        "execution": {
          "exit_code": 0,
          "stdout": "",
          "stderr": ""
        }
      },
      "cleanup_commands": [
        "rm -f test_file1 test_file2"
      ]
    },
    {
      "command": "sync",
      "description": "同步只写文件",
      "args": ["test_file"],
      "setup_commands": [
        "touch test_file",
        "chmod 0200 test_file"
      ],
      "expectation": {
        "execution": {
          "exit_code": 0,
          "stdout": "",
          "stderr": ""
        }
      },
      "cleanup_commands": [
        "chmod 0644 test_file",
        "rm -f test_file"
      ]
    },
    {
      "command": "sync",
      "description": "原始字节路径用例：LC_ALL=C、LANG=C；参数完整十六进制=6e6f6e7574662dff，对应文件名 nonutf-\\xff；创建该文件后执行 sync；stdin、stdout 和 stderr 均为 0 字节（完整十六进制为空），预期 RC=0。",
      "args": [
        "6e6f6e7574662dff"
      ],
      "setup_commands": [
        "export LC_ALL='C'",
        "export LANG='C'",
        "p=$(printf '%b' '\\156\\157\\156\\165\\164\\146\\055\\377'); printf data > \"$p\""
      ],
      "expectation": {
        "execution": {
          "exit_code": 0,
          "stdout": "",
          "stderr": ""
        }
      },
      "cleanup_commands": [
        "rm -f -- \"$(printf '\\156\\157\\156\\165\\164\\146\\055\\377')\""
      ],
      "tstdin": "",
      "byteMode": true
    },
    {
      "command": "sync",
      "description": "原始字节错误诊断用例：LC_ALL=C、LANG=C；参数完整十六进制=6d697373696e672dff，对应不存在的文件名 missing-\\xff；stdin 为 0 字节（完整十六进制为空）；预期 RC=1、stdout 为 0 字节，stderr 为 65 字节，完整十六进制=73796e633a206572726f72206f70656e696e6720276d697373696e672d2724275c333737273a204e6f20737563682066696c65206f72206469726563746f72790a，对应 GNU 的 'missing-'$'\\377' 路径引用。",
      "args": [
        "6d697373696e672dff"
      ],
      "setup_commands": [
        "export LC_ALL='C'",
        "export LANG='C'"
      ],
      "expectation": {
        "execution": {
          "exit_code": 1,
          "stdout": "",
          "stderr": "73796e633a206572726f72206f70656e696e6720276d697373696e672d2724275c333737273a204e6f20737563682066696c65206f72206469726563746f72790a"
        }
      },
      "cleanup_commands": [],
      "tstdin": "",
      "byteMode": true
    },
    {
      "command": "sync",
      "description": "UTF-8 locale 路径诊断用例：LC_ALL=C.UTF-8、LANG=C.UTF-8；参数为不存在的有效 UTF-8 文件名 missing-中；预期 RC=1、stdout 为空，stderr 原样保留 UTF-8 文件名并以单引号引用。",
      "args": [
        "missing-中"
      ],
      "expectation": {
        "execution": {
          "exit_code": 1,
          "stdout": "",
          "stderr": "sync: error opening 'missing-中': No such file or directory\n"
        }
      },
      "environment": {
        "env_vars": {
          "LC_ALL": "C.UTF-8",
          "LANG": "C.UTF-8"
        }
      }
    }
  ]
}
