    {
      "tstdin": "",
      "command": "tac",
      "description": "LC_ALL=C下重复指定-b/--before、-r/--regex和-s/--separator；GNU允许幂等布尔选项重复，并对带值的分隔符采用最后一个逗号，预期按before模式输出,,ca:b",
      "setup_commands": [
        "export LC_ALL='C'",
        "printf 'a:b,c,' > repeated-options.txt"
      ],
      "args": [
        "-b",
        "--before",
        "-r",
        "--regex",
        "-s",
        ":",
        "--separator",
        ",",
        "repeated-options.txt"
      ],
      "expectation": {
        "execution": {
          "exit_code": 0,
          "stdout": ",,ca:b",
          "stderr": ""
        },
        "verifications": []
      },
      "cleanup_commands": [
        "rm -f repeated-options.txt"
      ]
    },
    {
      "tstdin": "",
      "command": "tac",
      "description": "POSIXLY_CORRECT=1时在首个操作数input后传入-b；GNU在首个操作数停止选项解析并将-b作为第二个文件，预期先倒序input再输出名为-b的文件内容",
      "setup_commands": [
        "printf 'a\\nb\\n' > input",
        "printf 'dash\\n' > ./-b"
      ],
      "args": [
        "input",
        "-b"
      ],
      "environment": {
        "env_vars": {
          "LC_ALL": "C",
          "POSIXLY_CORRECT": "1"
        }
      },
      "expectation": {
        "execution": {
          "exit_code": 0,
          "stdout": "b\\na\\ndash\\n",
          "stderr": ""
        },
        "verifications": []
      },
      "cleanup_commands": [
        "rm -f input ./-b"
      ]
    },
    {
      "command": "tac",
      "description": "原始字节用例：LC_ALL=C下处理文件名0xff；参数完整十六进制=ff，fixture文件内容为first\\nsecond\\n；GNU接受Linux非UTF-8文件名并按换行倒序，预期stdout完整十六进制=7365636f6e640a66697273740a、stderr为空、RC=0",
      "args": [
        "ff"
      ],
      "setup_commands": [
        "export LC_ALL='C'",
        "name=$(printf '\\377'); printf 'first\\nsecond\\n' > \"$name\""
      ],
      "expectation": {
        "execution": {
          "exit_code": 0,
          "stdout": "7365636f6e640a66697273740a",
          "stderr": ""
        }
      },
      "environment": {
        "standardStreams": {
          "stderr": "capture"
        }
      },
      "cleanup_commands": [
        "name=$(printf '\\377'); rm -f -- \"$name\""
      ],
      "tstdin": "",
      "byteMode": true
    },
    {
      "command": "tac",
      "description": "原始字节用例：LC_ALL=C下执行tac -s 0xff bytes；参数完整十六进制=2d73 ff 6279746573，fixture bytes完整十六进制=78ff79ff；GNU把0xff作为固定分隔符并倒序记录，预期stdout完整十六进制=79ff78ff、stderr为空、RC=0",
      "args": [
        "2d73",
        "ff",
        "6279746573"
      ],
      "setup_commands": [
