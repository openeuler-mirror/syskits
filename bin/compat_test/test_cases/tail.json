    {
      "command": "tail",
      "description": "Linux下默认_POSIX2_VERSION规则中，旧式+NUM是文件操作数；缺失+1后仍输出后续文件完整内容及文件头。",
      "setup_commands": [
        "printf 'line1\\nline2\\n' > tail-plus-number-input"
      ],
      "args": ["+1", "tail-plus-number-input"],
      "expectation": {
        "execution": {
