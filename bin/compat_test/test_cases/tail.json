        "ignore_fields": {
          "ignore_exit_code": true
        }
      },
      "timeout": 2,
      "cleanup_commands": ["rm -f tail-link-switch.txt tail-link-switch-new tail-link-switch-target.txt"],
      "tags": ["linux", "follow", "name", "symlink", "polling", "replace"]
    }
  ]
