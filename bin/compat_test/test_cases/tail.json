      "args": ["-n", "+2"],
      "stdin": "x\ny\n",
      "expectation": {
        "execution": {
          "exit_code": 0,
          "stdout": "y\n",
          "stderr": ""
        }
      }
    },
    {
      "command": "tail",
      "description": "Modern: -c 2 (last 2 bytes)",
      "args": ["-c", "2"],
      "stdin": "abcd\n",
      "expectation": {
        "execution": {
          "exit_code": 0,
