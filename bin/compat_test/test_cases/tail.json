    },
    {
      "command": "tail",
      "description": "Linux下--follow=name运行中将tail-link-switch.txt原子替换为指向目标的符号链接；目标初始字节=7461726765740a，随后追加=61646465640a，预期stdout完整字节=7461726765740a61646465640a，stderr为替换诊断。",
      "setup_commands": [
        "printf 'old\\n' > tail-link-switch.txt; printf 'target\\n' > tail-link-switch-target.txt; (sleep .3; ln -s tail-link-switch-target.txt tail-link-switch-new; mv -T tail-link-switch-new tail-link-switch.txt; sleep .2; printf 'added\\n' >> tail-link-switch-target.txt) >/dev/null 2>&1 &"
      ],
      "args": ["--follow=name", "--sleep-interval=.1", "-n", "0", "tail-link-switch.txt"],
      "expectation": {
        "execution": {
          "exit_code": 0,
          "stdout": "target\nadded\n",
          "stderr": "tail: 'tail-link-switch.txt' has been replaced;  following new file\n"
