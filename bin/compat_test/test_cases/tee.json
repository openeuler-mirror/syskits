{
  "tests": [
      {
          "tstdin": "",
          "command": "tee",
          "description": "基本用法，无参数，验证标准输入输出",
          "setup_commands": [],
          "args": [],
          "expectation": {
              "execution": {
                  "exit_code": 0,
                  "stdout": "",
                  "stderr": ""
              },
              "verifications": [
                  {
                      "command": "",
                      "expected_exit": 0,
                      "expected_stdout": ""
                  }
              ]
          },
          "cleanup_commands": [""]
      },
      {
          "tstdin": "Hello, World!\n",
          "command": "tee",
          "description": "将标准输入写入文件并输出到标准输出",
          "setup_commands": [],
          "args": ["test_file.txt"],
          "expectation": {
              "execution": {
                  "exit_code": 0,
                  "stdout": "Hello, World!\n",
                  "stderr": ""
              },
              "file_checks": {
                  "test_file.txt": {
                      "content": "Hello, World!\n"
                  }
              }
          },
          "cleanup_commands": ["rm -f test_file.txt"]
      },
      {
          "tstdin": "Append this text.\n",
          "command": "tee",
          "description": "使用 -a 选项追加内容到现有文件",
          "setup_commands": [
              "echo 'Initial content.' > test_file.txt"
          ],
          "args": ["-a", "test_file.txt"],
          "expectation": {
              "execution": {
                  "exit_code": 0,
                  "stdout": "Append this text.\n",
                  "stderr": ""
              },
              "file_checks": {
                  "test_file.txt": {
                      "content": "Initial content.\nAppend this text.\n"
                  }
              }
          },
          "cleanup_commands": ["rm -f test_file.txt"]
      },
      {
          "tstdin": "Append this text.\n",
          "command": "tee",
          "description": "重复-a按GNU getopt语义生效，仍只执行一次追加写入",
          "setup_commands": [
              "echo 'Initial content.' > repeated_append.txt"
          ],
          "args": ["-a", "-a", "repeated_append.txt"],
          "expectation": {
              "execution": {
                  "exit_code": 0,
                  "stdout": "Append this text.\n",
                  "stderr": ""
              },
              "file_checks": {
                  "repeated_append.txt": {
                      "content": "Initial content.\nAppend this text.\n"
                  }
              }
          },
          "cleanup_commands": ["rm -f repeated_append.txt"]
      },
      {
          "tstdin": "Write to multiple files.\n",
          "command": "tee",
          "description": "将输入写入多个文件",
          "setup_commands": [],
          "args": ["file1.txt", "file2.txt"],
          "expectation": {
              "execution": {
                  "exit_code": 0,
                  "stdout": "Write to multiple files.\n",
                  "stderr": ""
              },
              "file_checks": {
                  "file1.txt": {
                      "content": "Write to multiple files.\n"
                  },
                  "file2.txt": {
                      "content": "Write to multiple files.\n"
                  }
              }
          },
          "cleanup_commands": ["rm -f file1.txt file2.txt"]
      },
      {
          "tstdin": "Attempt to write to non-writable file.\n",
          "command": "tee",
          "description": "尝试写入不可写文件，验证错误处理",
          "setup_commands": [
              "mkdir -p test_dir",
              "chmod 555 test_dir",
              "touch test_dir/non_writable.txt"
          ],
          "args": ["test_dir/non_writable.txt"],
          "expectation": {
              "execution": {
                  "exit_code": 1,
                  "stdout": "Attempt to write to non-writable file.\n",
                  "stderr": ".*Permission denied.*"
              }
          },
          "cleanup_commands": ["rm -rf test_dir"]
      },
      {
          "tstdin": "xxxxxxxx",
          "command": "tee",
          "description": "LC_ALL=C、LANG=C下执行tee --output-error=exit out；stdin为8字节xxxxxxxx，stdout连接/dev/full，无预置文件fixture；预期RC=1、stdout为0字节，stderr为tee: 'standard output': No space left on device加换行，并验证out存在且大小为0字节，确认致命标准输出写错误后不再把当前输入块写入文件；迁移原Cargo用例tee_exit_mode_does_not_write_a_block_after_stdout_breaks",
          "setup_commands": [
              "export LC_ALL='C'",
              "export LANG='C'"
          ],
          "args": ["--output-error=exit", "out"],
          "expectation": {
              "execution": {
                  "exit_code": 1,
                  "stdout": "",
                  "stderr": "tee: 'standard output': No space left on device\n"
              },
              "verifications": [
                  {
                      "command": "stat -c '%s' out",
                      "expected_exit": 0,
                      "expected_stdout": "0\n",
                      "expected_stderr": ""
                  }
              ]
          },
          "environment": {
              "standardStreams": {
                  "stdout": "full"
              }
          },
          "cleanup_commands": []
      },
      {
          "tstdin": "x",
          "command": "tee",
          "description": "--output-error未指定MODE时采用GNU warn-nopipe：stdout已关闭的管道不诊断、不失败，输入仍写入普通输出文件",
          "setup_commands": [
              "export LC_ALL='C'",
              "export LANG='C'"
          ],
          "args": ["--output-error", "output_error_default_out"],
          "expectation": {
              "execution": {
                  "exit_code": 0,
                  "stdout": "",
                  "stderr": ""
              },
              "verifications": [
                  {
                      "command": "stat -c '%s' output_error_default_out",
                      "expected_exit": 0,
                      "expected_stdout": "1\n",
                      "expected_stderr": ""
                  }
              ]
          },
          "environment": {
              "standardStreams": {
                  "stdout": "closed_pipe"
              }
          },
          "cleanup_commands": []
      },
      {
          "tstdin": "x",
          "command": "tee",
          "description": "-p模式下FILE打开失败且stdout为无读端管道时，tee只保留真实输出端并返回FILE打开失败状态",
          "setup_commands": [
              "export LC_ALL='C'",
              "export LANG='C'"
          ],
          "args": ["-p", "missing-parent/out"],
          "expectation": {
              "execution": {
                  "exit_code": 1,
                  "stdout": "",
                  "stderr": "tee: missing-parent/out: No such file or directory\n"
              }
          },
          "environment": {
              "standardStreams": {
                  "stdout": "closed_pipe"
              }
          },
          "cleanup_commands": []
      },
      {
          "tstdin": "x",
          "command": "tee",
          "description": "--output-error=exit后接-p时按GNU getopt使用最后的-p，即warn-nopipe忽略关闭stdout管道并继续写入普通文件",
          "setup_commands": [
              "export LC_ALL='C'",
              "export LANG='C'"
          ],
          "args": ["--output-error=exit", "-p", "last_mode_out"],
          "expectation": {
              "execution": {
                  "exit_code": 0,
                  "stdout": "",
                  "stderr": ""
              },
              "verifications": [
                  {
                      "command": "stat -c '%s' last_mode_out",
                      "expected_exit": 0,
                      "expected_stdout": "1\n",
                      "expected_stderr": ""
                  }
              ]
          },
          "environment": {
              "standardStreams": {
                  "stdout": "closed_pipe"
              }
          },
          "cleanup_commands": []
      },
      {
          "tstdin": "x",
          "command": "tee",
          "description": "调用方忽略SIGPIPE且stdout无读端时，默认tee保留继承的忽略处置，不诊断并继续将输入写入普通文件",
          "setup_commands": [
              "export LC_ALL='C'",
              "export LANG='C'"
          ],
          "args": ["inherited_sigpipe_out"],
          "expectation": {
              "execution": {
                  "exit_code": 0,
                  "stdout": "",
                  "stderr": ""
              },
              "verifications": [
                  {
                      "command": "stat -c '%s' inherited_sigpipe_out",
                      "expected_exit": 0,
                      "expected_stdout": "1\n",
                      "expected_stderr": ""
                  }
              ]
          },
          "environment": {
              "standardStreams": {
                  "stdout": "closed_pipe",
                  "sigpipe": "ignore"
              }
          },
          "cleanup_commands": []
      },
      {
          "tstdin": "",
          "command": "tee",
          "description": "stdin连接目录描述符时，GNU将read失败诊断为read error并返回失败状态",
          "setup_commands": [
              "export LC_ALL='C'",
              "export LANG='C'",
              "mkdir stdin-directory"
          ],
          "args": [],
          "expectation": {
              "execution": {
                  "exit_code": 1,
                  "stdout": "",
                  "stderr": "tee: read error: Is a directory\n"
              }
          },
          "environment": {
              "standardStreams": {
                  "stdinFile": "stdin-directory"
              }
          },
          "cleanup_commands": ["rmdir stdin-directory"]
      },
      {
          "tstdin": "x",
          "command": "tee",
          "description": "启动前stdout关闭时，tee应将标准输出报告为Bad file descriptor，并继续写入普通FILE输出",
          "setup_commands": [
              "export LC_ALL='C'",
              "export LANG='C'"
          ],
          "args": ["closed_stdout_file"],
          "expectation": {
              "execution": {
                  "exit_code": 1,
                  "stdout": "",
                  "stderr": "tee: 'standard output': Bad file descriptor\n"
              },
              "verifications": [
                  {
                      "command": "stat -c '%s' closed_stdout_file",
                      "expected_exit": 0,
                      "expected_stdout": "1\n",
                      "expected_stderr": ""
                  }
              ]
          },
          "environment": {
              "standardStreams": {
                  "stdout": "closed"
              }
          },
          "cleanup_commands": []
      },
      {
          "tstdin": "x",
          "command": "tee",
          "description": "启动前stdout关闭且FILE引用/proc/self/fd/1时，tee应保持原始关闭描述符语义并先报告FILE不存在",
          "setup_commands": [
              "export LC_ALL='C'",
              "export LANG='C'"
          ],
          "args": ["/proc/self/fd/1"],
          "expectation": {
              "execution": {
                  "exit_code": 1,
                  "stdout": "",
                  "stderr": "tee: /proc/self/fd/1: No such file or directory\ntee: 'standard output': Bad file descriptor\n"
              }
          },
          "environment": {
              "standardStreams": {
                  "stdout": "closed"
              }
          },
          "cleanup_commands": []
      },
      {
          "tstdin": "",
          "command": "tee",
          "description": "启动前stdin关闭时，tee在创建普通FILE后应依次报告read error和standard input的Bad file descriptor",
          "setup_commands": [
              "export LC_ALL='C'",
              "export LANG='C'"
          ],
          "args": ["closed_stdin_file"],
          "expectation": {
              "execution": {
                  "exit_code": 1,
                  "stdout": "",
                  "stderr": "tee: read error: Bad file descriptor\ntee: standard input: Bad file descriptor\n"
              },
              "verifications": [
                  {
                      "command": "stat -c '%s' closed_stdin_file",
                      "expected_exit": 0,
                      "expected_stdout": "0\n",
                      "expected_stderr": ""
                  }
              ]
          },
          "environment": {
              "standardStreams": {
                  "stdin": "closed"
              }
          },
          "cleanup_commands": []
      },
      {
          "tstdin": "",
          "command": "tee",
          "description": "启动前stdin关闭且FILE引用/proc/self/fd/0时，tee应先报告FILE不存在，再保留stdin的GNU读取和关闭诊断",
          "setup_commands": [
              "export LC_ALL='C'",
              "export LANG='C'"
          ],
          "args": ["/proc/self/fd/0"],
          "expectation": {
              "execution": {
                  "exit_code": 1,
                  "stdout": "",
                  "stderr": "tee: /proc/self/fd/0: No such file or directory\ntee: read error: Bad file descriptor\ntee: standard input: Bad file descriptor\n"
              }
          },
          "environment": {
              "standardStreams": {
                  "stdin": "closed"
              }
          },
          "cleanup_commands": []
      },
      {
          "tstdin": "x",
          "command": "tee",
