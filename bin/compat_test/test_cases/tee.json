{
  "tests": [
      {
          "tstdin": "",
          "command": "tee",
          "description": "基本用法，无参数，验证标准输入输出",
          "setup_commands": [],
          "args": [],
          "expectation": {
              "execution": {
                  "exit_code": 0,
                  "stdout": "",
                  "stderr": ""
              },
              "verifications": [
                  {
                      "command": "",
                      "expected_exit": 0,
                      "expected_stdout": ""
                  }
              ]
          },
          "cleanup_commands": [""]
      },
      {
          "tstdin": "Hello, World!\n",
          "command": "tee",
          "description": "将标准输入写入文件并输出到标准输出",
          "setup_commands": [],
          "args": ["test_file.txt"],
          "expectation": {
              "execution": {
                  "exit_code": 0,
                  "stdout": "Hello, World!\n",
                  "stderr": ""
              },
              "file_checks": {
                  "test_file.txt": {
                      "content": "Hello, World!\n"
                  }
              }
          },
          "cleanup_commands": ["rm -f test_file.txt"]
      },
      {
          "tstdin": "Append this text.\n",
          "command": "tee",
          "description": "使用 -a 选项追加内容到现有文件",
          "setup_commands": [
              "echo 'Initial content.' > test_file.txt"
          ],
          "args": ["-a", "test_file.txt"],
          "expectation": {
              "execution": {
                  "exit_code": 0,
                  "stdout": "Append this text.\n",
                  "stderr": ""
              },
              "file_checks": {
                  "test_file.txt": {
                      "content": "Initial content.\nAppend this text.\n"
                  }
              }
          },
          "cleanup_commands": ["rm -f test_file.txt"]
      },
      {
          "tstdin": "Append this text.\n",
          "command": "tee",
          "description": "重复-a按GNU getopt语义生效，仍只执行一次追加写入",
          "setup_commands": [
              "echo 'Initial content.' > repeated_append.txt"
          ],
          "args": ["-a", "-a", "repeated_append.txt"],
          "expectation": {
              "execution": {
                  "exit_code": 0,
                  "stdout": "Append this text.\n",
                  "stderr": ""
              },
              "file_checks": {
                  "repeated_append.txt": {
                      "content": "Initial content.\nAppend this text.\n"
                  }
              }
          },
          "cleanup_commands": ["rm -f repeated_append.txt"]
      },
      {
          "tstdin": "Write to multiple files.\n",
          "command": "tee",
          "description": "将输入写入多个文件",
          "setup_commands": [],
          "args": ["file1.txt", "file2.txt"],
          "expectation": {
              "execution": {
                  "exit_code": 0,
                  "stdout": "Write to multiple files.\n",
                  "stderr": ""
              },
              "file_checks": {
                  "file1.txt": {
                      "content": "Write to multiple files.\n"
                  },
                  "file2.txt": {
                      "content": "Write to multiple files.\n"
                  }
              }
          },
          "cleanup_commands": ["rm -f file1.txt file2.txt"]
      },
      {
          "tstdin": "Attempt to write to non-writable file.\n",
          "command": "tee",
          "description": "尝试写入不可写文件，验证错误处理",
          "setup_commands": [
              "mkdir -p test_dir",
              "chmod 555 test_dir",
              "touch test_dir/non_writable.txt"
          ],
          "args": ["test_dir/non_writable.txt"],
          "expectation": {
              "execution": {
                  "exit_code": 1,
                  "stdout": "Attempt to write to non-writable file.\n",
                  "stderr": ".*Permission denied.*"
              }
          },
          "cleanup_commands": ["rm -rf test_dir"]
      },
      {
          "tstdin": "xxxxxxxx",
          "command": "tee",
          "description": "LC_ALL=C、LANG=C下执行tee --output-error=exit out；stdin为8字节xxxxxxxx，stdout连接/dev/full，无预置文件fixture；预期RC=1、stdout为0字节，stderr为tee: 'standard output': No space left on device加换行，并验证out存在且大小为0字节，确认致命标准输出写错误后不再把当前输入块写入文件；迁移原Cargo用例tee_exit_mode_does_not_write_a_block_after_stdout_breaks",
          "setup_commands": [
              "export LC_ALL='C'",
              "export LANG='C'"
          ],
          "args": ["--output-error=exit", "out"],
          "expectation": {
              "execution": {
                  "exit_code": 1,
                  "stdout": "",
                  "stderr": "tee: 'standard output': No space left on device\n"
              },
              "verifications": [
                  {
                      "command": "stat -c '%s' out",
                      "expected_exit": 0,
                      "expected_stdout": "0\n",
                      "expected_stderr": ""
                  }
              ]
          },
          "environment": {
              "standardStreams": {
                  "stdout": "full"
              }
          },
          "cleanup_commands": []
      },
      {
          "tstdin": "x",
          "command": "tee",
          "description": "--output-error未指定MODE时采用GNU warn-nopipe：stdout已关闭的管道不诊断、不失败，输入仍写入普通输出文件",
          "setup_commands": [
              "export LC_ALL='C'",
              "export LANG='C'"
          ],
          "args": ["--output-error", "output_error_default_out"],
          "expectation": {
              "execution": {
                  "exit_code": 0,
                  "stdout": "",
                  "stderr": ""
              },
              "verifications": [
                  {
                      "command": "stat -c '%s' output_error_default_out",
                      "expected_exit": 0,
                      "expected_stdout": "1\n",
                      "expected_stderr": ""
                  }
              ]
          },
          "environment": {
              "standardStreams": {
                  "stdout": "closed_pipe"
              }
          },
          "cleanup_commands": []
      },
      {
          "tstdin": "x",
          "command": "tee",
          "description": "--output-error=exit后接-p时按GNU getopt使用最后的-p，即warn-nopipe忽略关闭stdout管道并继续写入普通文件",
          "setup_commands": [
              "export LC_ALL='C'",
              "export LANG='C'"
          ],
          "args": ["--output-error=exit", "-p", "last_mode_out"],
          "expectation": {
              "execution": {
                  "exit_code": 0,
                  "stdout": "",
                  "stderr": ""
              },
              "verifications": [
                  {
                      "command": "stat -c '%s' last_mode_out",
                      "expected_exit": 0,
                      "expected_stdout": "1\n",
                      "expected_stderr": ""
                  }
              ]
          },
          "environment": {
              "standardStreams": {
                  "stdout": "closed_pipe"
              }
          },
          "cleanup_commands": []
      },
      {
          "tstdin": "78",
          "command": "tee",
          "description": "原始字节用例：LC_ALL=C、LANG=C下执行tee tee-\\xff-output；参数完整十六进制=7465652dff6f7574707574；stdin为1字节、完整十六进制=78；输入fixture：无文件fixture；预期RC=0，stderr为0字节、完整十六进制=空，stdout为1字节、完整十六进制=78，确认Linux非UTF-8输出文件名可直接创建并写入。",
          "args": ["7465652dff6f7574707574"],
          "setup_commands": [
              "export LC_ALL='C'",
              "export LANG='C'"
          ],
          "expectation": {
              "execution": {
                  "exit_code": 0,
                  "stdout": "78",
                  "stderr": ""
              }
          },
          "cleanup_commands": [],
          "byteMode": true
      },
      {
          "tstdin": "",
          "command": "tee",
          "description": "--output-error=exit在没有读取到输入时不执行写入；即使stdout已关闭的管道也应按GNU返回0、无诊断并保留空输出文件",
          "setup_commands": [
              "export LC_ALL='C'",
              "export LANG='C'"
          ],
          "args": ["--output-error=exit", "empty_exit_out"],
          "expectation": {
              "execution": {
                  "exit_code": 0,
                  "stdout": "",
                  "stderr": ""
              },
              "verifications": [
                  {
                      "command": "stat -c '%s' empty_exit_out",
                      "expected_exit": 0,
                      "expected_stdout": "0\n",
                      "expected_stderr": ""
                  }
              ]
          },
          "environment": {
              "standardStreams": {
                  "stdout": "closed_pipe"
              }
          },
          "cleanup_commands": []
      }
  ]
}
