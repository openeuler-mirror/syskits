            "setup_commands": [
                "touch -t 203001010000 reference",
                "touch -t 200001010000 target",
                "touch -a -t 200101010000 target"
            ],
            "args": [
                "--time=a",
                "-r",
                "reference",
                "target"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "test \"$(stat -c '%X:%Y' target)\" = 1893456000:946684800",
                        "expected_exit": 0,
                        "expected_stdout": ""
                    }
                ]
            },
            "environment": {
                "clearEnv": true,
                "env_vars": {
                    "LC_ALL": "C",
                    "LANG": "C",
                    "TZ": "UTC0"
                }
            },
            "cleanup_commands": [
                "rm -f reference target"
            ]
        },
