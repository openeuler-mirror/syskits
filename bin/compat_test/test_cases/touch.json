{
    "tests": [
        {
            "tstdin": "",
            "command": "touch",
            "description": "基本功能测试 - 创建新文件",
            "args": ["new_file"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "test -f new_file && echo 'exists'",
                        "expected_exit": 0,
                        "expected_stdout": "exists"
                    }
                ]
            },
            "cleanup_commands": [
                "rm -f new_file"
            ]
        },
        {
            "tstdin": "",
            "command": "touch",
            "description": "更新已存在文件的时间戳",
            "setup_commands": [
                "touch -d '2000-01-01' old_file"
            ],
            "args": ["old_file"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "test $(date -r old_file +%Y) -gt 2000 && echo 'updated'",
                        "expected_exit": 0,
                        "expected_stdout": "updated"
                    }
                ]
            },
            "cleanup_commands": [
                "rm -f old_file"
            ]
        },
        {
            "tstdin": "",
            "command": "touch",
            "description": "创建多个文件",
            "args": ["file1", "file2", "file3"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "test -f file1 && test -f file2 && test -f file3 && echo 'all exist'",
                        "expected_exit": 0,
                        "expected_stdout": "all exist"
                    }
                ]
            },
            "cleanup_commands": [
                "rm -f file1 file2 file3"
            ]
        },
        {
            "tstdin": "",
            "command": "touch",
            "description": "设置特定时间",
            "args": ["-t", "202001010000.00", "dated_file"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "date -r dated_file '+%Y%m%d%H%M.%S'",
                        "expected_exit": 0,
                        "expected_stdout": "202001010000.00"
                    }
                ]
            },
            "cleanup_commands": [
                "rm -f dated_file"
            ]
        },
        {
            "tstdin": "",
            "command": "touch",
            "description": "只更改访问时间",
