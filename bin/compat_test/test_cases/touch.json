                "verifications": [
                    {
                        "command": "test $(date -r test_file '+%Y%m%d%H%M.%S') = '202001010000.00' && echo 'matched'",
                        "expected_exit": 0,
                        "expected_stdout": "matched"
                    }
                ]
            },
            "cleanup_commands": [
                "rm -f reference_file test_file"
            ]
        },
        {
            "tstdin": "",
            "command": "touch",
            "description": "LC_ALL=C、LANG=C下默认-r必须跟随悬挂符号链接；引用dangling指向不存在的missing-target时，GNU返回RC=1并报告failed to get attributes，不得把链接自身时间复制给target。",
            "setup_commands": [
                "ln -s missing-target dangling"
            ],
            "args": [
                "-r",
                "dangling",
                "target"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "touch: failed to get attributes of 'dangling': No such file or directory\n"
                },
                "verifications": [
                    {
                        "command": "test ! -e target",
                        "expected_exit": 0,
                        "expected_stdout": ""
                    }
                ]
            },
            "environment": {
                "clearEnv": true,
                "env_vars": {
                    "LC_ALL": "C",
                    "LANG": "C",
                    "TZ": "UTC0"
                }
            },
            "cleanup_commands": [
                "rm -f dangling target"
            ]
        },
