        {
            "command": "tty",
            "description": "GNU 无参长选项附带值：--quiet=value 必须使用 quiet 别名诊断。",
            "args": [
                "--quiet=value"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 2,
                    "stdout": "",
                    "stderr": "tty: option '--quiet' doesn't allow an argument\nTry 'tty --help' for more information.\n"
                }
            },
            "environment": {
                "env_vars": {
                    "LC_ALL": "C",
                    "LANG": "C"
                }
            }
        },
        {
            "command": "tty",
            "description": "GNU 长选项歧义候选：输入 --=；预期 RC=2、stdout 为空、stderr 仅列出 --silent、--help、--version，--quiet 作为 --silent 的别名不得重复出现。",
            "args": [
                "--="
            ],
            "expectation": {
                "execution": {
                    "exit_code": 2,
                    "stdout": "",
                    "stderr": "tty: option '--=' is ambiguous; possibilities: '--silent' '--help' '--version'\nTry 'tty --help' for more information.\n"
                }
            },
            "environment": {
                "env_vars": {
                    "LC_ALL": "C",
                    "LANG": "C"
                }
            }
        },
        {
            "command": "tty",
            "description": "stdout 为只读 /dev/null：输入为非终端；预期写入失败后 RC=3、stdout 为空、stderr 为 write error: Bad file descriptor。",
            "args": [],
            "expectation": {
                "execution": {
                    "exit_code": 3,
                    "stdout": "",
                    "stderr": "tty: write error: Bad file descriptor\n"
                }
            },
            "environment": {
                "env_vars": {
                    "LC_ALL": "C",
                    "LANG": "C"
                },
                "standardStreams": {
                    "stdout": "read_only_null"
                }
            }
        },
        {
            "command": "tty",
            "description": "stdout 初始关闭：输入为非终端；预期保持 GNU 的关闭描述符语义，RC=3、stdout 为空、stderr 为 write error: Bad file descriptor。",
            "args": [],
            "expectation": {
                "execution": {
                    "exit_code": 3,
                    "stdout": "",
