    "tests": [
        {
            "tstdin": "",
            "command": "uname",
            "description": "基本功能测试 - 无参数",
            "args": [],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "^[A-Za-z0-9_.-]+\\n$",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
