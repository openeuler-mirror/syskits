        {
            "tstdin": "",
            "command": "uname",
            "description": "显示硬件平台",
            "args": ["-i"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "^[A-Za-z0-9_.-]+\\n$",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "uname",
            "description": "LC_ALL=C下执行uname extra；uname不接受操作数，GNU预期RC=1、stdout为空，并报告extra operand及Try help诊断",
            "setup_commands": [
                "export LC_ALL='C'"
            ],
            "args": [
                "extra"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "uname: extra operand 'extra'\nTry 'uname --help' for more information.\n"
                },
                "verifications": []
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "byteMode": true,
            "command": "uname",
            "description": "原始字节操作数诊断用例：export LC_ALL='C'；执行uname并传入单个操作数原始字节0xff；参数完整十六进制=ff；GNU按C locale引用不可打印字节为\\377，预期RC=1，stdout完整十六进制=空，stderr完整十六进制=756e616d653a206578747261206f706572616e6420275c333737270a5472792027756e616d65202d2d68656c702720666f72206d6f726520696e666f726d6174696f6e2e0a",
            "setup_commands": [
                "export LC_ALL='C'"
            ],
            "args": [
                "ff"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "756e616d653a206578747261206f706572616e6420275c333737270a5472792027756e616d65202d2d68656c702720666f72206d6f726520696e666f726d6174696f6e2e0a"
                },
                "verifications": []
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "uname",
            "description": "LC_ALL=C下执行uname --oper=value；--oper唯一匹配--operating-system且该选项不接受值，GNU预期RC=1、stdout为空，并用规范长选项名报告doesn't allow an argument",
            "setup_commands": [
                "export LC_ALL='C'"
            ],
            "args": [
                "--oper=value"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "uname: option '--operating-system' doesn't allow an argument\nTry 'uname --help' for more information.\n"
                },
                "verifications": []
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "uname",
            "description": "LC_ALL=C下执行uname --kernel；该缩写同时匹配三个kernel长选项，GNU预期RC=1、stdout为空，并按选项表顺序列出全部可能项",
            "setup_commands": [
                "export LC_ALL='C'"
            ],
            "args": [
                "--kernel"
            ],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "uname: option '--kernel' is ambiguous; possibilities: '--kernel-name' '--kernel-release' '--kernel-version'\nTry 'uname --help' for more information.\n"
                },
                "verifications": []
            },
            "cleanup_commands": []
        }
    ]
