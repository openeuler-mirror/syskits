{
    "tests": [
        {
            "tstdin": "",
            "command": "uname",
            "description": "基本功能测试 - 无参数",
            "args": [],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "^[A-Za-z0-9_.-]+\\n$",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "uname",
            "description": "显示所有信息",
            "args": ["-a"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "^[A-Za-z0-9_.-]+\\s+[A-Za-z0-9_.-]+\\s+[0-9][0-9.]*[0-9](?:-[A-Za-z0-9]+)?\\s+(?:#[0-9]+\\s+)?[A-Za-z0-9_.-]+\\s+[A-Za-z0-9_.-]+(?:\\s+[A-Za-z0-9_.-]+)*\\n$",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "uname",
            "description": "显示内核名称",
            "args": ["-s"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "^[A-Za-z0-9_.-]+\\n$",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
