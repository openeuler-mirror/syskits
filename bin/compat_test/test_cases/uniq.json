{
    "tests": [
        {
            "tstdin": "a\na\nb\nc\nc\nd\n",
            "command": "uniq",
            "description": "基本功能测试 - 删除相邻的重复行",
            "args": [],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "a\nb\nc\nd\n",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "a\n",
            "command": "uniq",
            "description": "stdout连接无读端管道且调用方使用默认SIGPIPE时，GNU在首次写入时由SIGPIPE终止，预期RC=141且无输出和诊断",
            "args": [],
            "environment": {
                "standardStreams": {
                    "stdout": "closed_pipe",
                    "sigpipe": "default",
                    "useBash": true
                },
                "env_vars": {
                    "LC_ALL": "C",
                    "LANG": "C"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 141,
                    "stdout": "",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "a\n",
            "command": "uniq",
            "description": "stdout连接无读端管道且调用方显式忽略SIGPIPE时，GNU保留忽略处置并报告write error，预期RC=1且无stdout",
            "args": [],
            "environment": {
                "standardStreams": {
                    "stdout": "closed_pipe",
                    "sigpipe": "ignore",
                    "useBash": true
                },
                "env_vars": {
                    "LC_ALL": "C",
                    "LANG": "C"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "uniq: write error: Broken pipe\n"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "uniq",
            "description": "POSIXLY_CORRECT=1时在INPUT后停止扫描选项：input -c中的-c是OUTPUT文件名，stdout为空且输出文件只包含去重后的a",
            "setup_commands": [
                "printf 'a\\na\\n' > input"
            ],
            "args": ["input", "-c"],
            "environment": {
                "env_vars": {
                    "POSIXLY_CORRECT": "1",
                    "LC_ALL": "C",
                    "LANG": "C"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "cat -- -c",
                        "expected_exit": 0,
                        "expected_stdout": "a\\n"
                    }
                ]
            },
            "cleanup_commands": [
                "rm -f -- input -c"
            ]
        },
        {
            "tstdin": "aX\nbX\n",
            "command": "uniq",
            "description": "POSIXLY_CORRECT=1时单独的-是首个INPUT，后续+1必须作为OUTPUT路径而非旧式跳过字符选项",
            "args": ["-", "+1"],
            "environment": {
                "env_vars": {
                    "POSIXLY_CORRECT": "1",
                    "_POSIX2_VERSION": "200809",
                    "LC_ALL": "C",
                    "LANG": "C"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                },
                "verifications": [
                    {
                        "command": "cat -- +1",
                        "expected_exit": 0,
                        "expected_stdout": "aX\nbX\n"
                    }
                ]
            },
            "cleanup_commands": [
                "rm -f -- +1"
            ]
        },
        {
            "tstdin": "",
            "command": "uniq",
            "description": "不存在的INPUT仅报告GNU格式的原始路径和系统错误，不添加Could not open前缀",
            "args": ["syskits-uniq-missing-input"],
            "environment": {
                "env_vars": {
                    "LC_ALL": "C",
                    "LANG": "C"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "uniq: syskits-uniq-missing-input: No such file or directory\\n"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "line\n",
            "command": "uniq",
            "description": "OUTPUT为/dev/full时必须在最终刷新阶段报告写入失败，不能因BufWriter析构忽略错误而返回成功",
            "args": ["-", "/dev/full"],
            "environment": {
                "env_vars": {
                    "LC_ALL": "C",
                    "LANG": "C"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "uniq: write error: No space left on device\n"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "uniq",
            "description": "INPUT是目录时GNU在读取阶段报告带引号的error reading诊断，不仅输出底层EISDIR文本",
            "setup_commands": [
                "mkdir input-dir"
            ],
            "args": ["input-dir"],
            "environment": {
                "env_vars": {
                    "LC_ALL": "C",
                    "LANG": "C"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "uniq: error reading 'input-dir': Is a directory\n"
                }
            },
            "cleanup_commands": [
                "rm -rf input-dir"
            ]
        },
        {
            "tstdin": "a X\nb X\n",
            "command": "uniq",
            "description": "-f数值参数沿用GNU strtoumax词法并接受前导空白，跳过一个字段后比较键均为X，预期仅保留首行",
            "args": ["-f", " 1"],
            "environment": {
                "env_vars": {
                    "LC_ALL": "C",
                    "LANG": "C"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "a X\n",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "a X\nb X\n",
            "command": "uniq",
            "description": "--skip-f是GNU唯一长选项前缀，后接+1必须作为其字段数值而非旧式+N选项；比较键均为X，预期仅保留首行",
            "args": ["--skip-f", "+1"],
            "environment": {
                "env_vars": {
                    "_POSIX2_VERSION": "200809",
                    "LC_ALL": "C",
                    "LANG": "C"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "a X\n",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "a X\na X\nb X\nb Y\n",
            "command": "uniq",
            "description": "组合短选项-cf1中f后的1是-f的紧随数值参数而非旧式字段跳过值，GNU按-count和-f 1执行并保留两个分组首行及计数",
            "args": ["-cf1"],
            "environment": {
                "env_vars": {
                    "LC_ALL": "C",
                    "LANG": "C"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "      3 a X\n      1 b Y\n",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "a\n",
            "command": "uniq",
            "description": "-s后的负数仍是该选项的参数，GNU按skip-chars专用错误文本拒绝而非将其当作未知选项",
            "args": ["-s", "-1"],
            "environment": {
                "env_vars": {
                    "LC_ALL": "C",
                    "LANG": "C"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "uniq: -1: invalid number of bytes to skip\n"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "a\n",
            "command": "uniq",
            "description": "短选项-f不接受等号分隔参数，-f=1中的=1必须按GNU作为无效字段跳过数值报错",
            "args": ["-f=1"],
            "environment": {
                "env_vars": {
                    "LC_ALL": "C",
                    "LANG": "C"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "uniq: =1: invalid number of fields to skip\n"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "uniq",
            "description": "必需值短选项-f缺少参数时，GNU仅输出option requires an argument诊断和帮助提示，不输出Clap用法块",
            "args": ["-f"],
            "environment": {
                "env_vars": {
                    "LC_ALL": "C",
                    "LANG": "C"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "uniq: option requires an argument -- 'f'\nTry 'uniq --help' for more information.\n"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "uniq",
