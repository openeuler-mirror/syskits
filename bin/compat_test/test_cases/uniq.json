            "args": ["-cx"],
            "environment": {
                "env_vars": {
                    "LC_ALL": "C",
                    "LANG": "C"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "uniq: invalid option -- 'x'\nTry 'uniq --help' for more information.\n"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "uniq",
            "description": "--s同时匹配--skip-fields和--skip-chars时，GNU输出歧义候选列表和标准帮助提示",
            "args": ["--s"],
            "environment": {
                "env_vars": {
                    "LC_ALL": "C",
                    "LANG": "C"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "uniq: option '--s' is ambiguous; possibilities: '--skip-fields' '--skip-chars'\nTry 'uniq --help' for more information.\n"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "uniq",
