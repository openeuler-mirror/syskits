{
    "tests": [
        {
            "tstdin": "",
            "command": "unlink",
            "description": "基本功能测试",
            "setup_commands": [
                "echo 'test' > test_file"
            ],
            "args": ["test_file"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "unlink",
            "description": "文件不存在测试",
            "args": ["nonexistent_file"],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "unlink: cannot unlink 'nonexistent_file': No such file or directory\n"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "unlink",
            "description": "目录测试",
            "setup_commands": [
                "mkdir test_dir"
            ],
            "args": ["test_dir"],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "unlink: cannot unlink 'test_dir': Is a directory\n"
                }
            },
            "cleanup_commands": [
                "rm -rf test_dir"
            ]
        },
        {
            "tstdin": "",
            "command": "unlink",
            "description": "缺少参数测试",
            "args": [],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "unlink: missing operand\nTry 'unlink --help' for more information.\n"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "unlink",
            "description": "LC_ALL=C、LANG=C下执行unlink --help=value；GNU标准帮助选项不允许等号参数，预期RC=1、stdout为空，stderr为option '--help' doesn't allow an argument及单行Try提示。",
            "args": ["--help=value"],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "unlink: option '--help' doesn't allow an argument\nTry 'unlink --help' for more information.\n"
                }
            },
            "environment": {
                "clearEnv": true,
                "env_vars": {
                    "LC_ALL": "C",
                    "LANG": "C"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "unlink",
            "description": "LC_ALL=C、LANG=C且未设置POSIXLY_CORRECT时执行unlink first second；unlink只接受一个FILE，预期RC=1、stdout为空，stderr将第二个参数诊断为extra operand 'second'并给出Try提示。",
            "args": ["first", "second"],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "unlink: extra operand 'second'\nTry 'unlink --help' for more information.\n"
                }
            },
            "environment": {
                "clearEnv": true,
                "env_vars": {
                    "LC_ALL": "C",
                    "LANG": "C"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "unlink",
            "description": "LC_ALL=C、LANG=C并设置POSIXLY_CORRECT=1时执行unlink first --version；GNU getopt在首个FILE后停止选项扫描，--version是第二个操作数，预期RC=1、stdout为空，stderr为extra operand '--version'及Try提示。",
            "args": ["first", "--version"],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "unlink: extra operand '--version'\nTry 'unlink --help' for more information.\n"
                }
            },
            "environment": {
                "clearEnv": true,
                "env_vars": {
                    "LC_ALL": "C",
                    "LANG": "C",
                    "POSIXLY_CORRECT": "1"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "byteMode": true,
            "command": "unlink",
            "description": "原始字节用例：LC_ALL=C、LANG=C下执行unlink，参数完整十六进制=ff（单个不存在文件名）；stdin为0字节、完整十六进制=空。GNU quoteaf 对不可表示文件名使用单引号包裹的八进制Shell转义，预期RC=1、stdout为空、stderr完整十六进制包含cannot unlink ''$'\\377'而不是Rust的$'\\xFF'。",
            "args": ["ff"],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "756e6c696e6b3a2063616e6e6f7420756e6c696e6b20272724275c333737273a204e6f20737563682066696c65206f72206469726563746f72790a"
                }
            },
            "environment": {
                "clearEnv": true,
                "env_vars": {
                    "LC_ALL": "C",
                    "LANG": "C"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "unlink",
            "description": "LC_ALL=zh_CN.utf8、LANG=zh_CN.utf8下执行unlink first second；GNU将extra operand和Try提示翻译为简体中文，并使用双引号包裹第二个操作数，预期RC=1、stdout为空、stderr为对应UTF-8诊断。",
            "args": ["first", "second"],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "unlink: 多余的操作对象 \"second\"\n请尝试执行 \"unlink --help\" 来获取更多信息。\n"
                }
            },
            "environment": {
                "clearEnv": true,
                "env_vars": {
                    "LC_ALL": "zh_CN.utf8",
                    "LANG": "zh_CN.utf8"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "unlink",
            "description": "LC_ALL=zh_CN.utf8、LANG=zh_CN.utf8下执行unlink missing；GNU将运行时cannot unlink前缀翻译为对FILE调用unlink失败，文件名仍按quoteaf单引号格式输出，预期RC=1、stdout为空、stderr为对应UTF-8诊断。",
            "args": ["missing"],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "unlink: 对 'missing' 调用 unlink 失败: No such file or directory\n"
                }
            },
            "environment": {
                "clearEnv": true,
                "env_vars": {
                    "LC_ALL": "zh_CN.utf8",
                    "LANG": "zh_CN.utf8"
                }
            },
            "cleanup_commands": []
        }
    ]
}
