{
    "tests": [
        {
            "tstdin": "",
            "command": "whoami",
            "description": "基本功能测试",
            "args": [],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "root\n",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "whoami",
            "description": "无效选项测试",
            "args": ["--invalid-option"],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "whoami: unrecognized option '--invalid-option'\nTry 'whoami --help' for more information.\n"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "whoami",
            "description": "LC_ALL=C下传入一个操作数；GNU whoami 不接受操作数，预期RC=1且使用extra operand诊断与帮助提示",
            "setup_commands": [
                "export LC_ALL='C'",
                "export LANG='C'"
            ],
            "args": ["operand"],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "whoami: extra operand 'operand'\nTry 'whoami --help' for more information.\n"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "whoami",
            "description": "LC_ALL=C下--help=value不接受附带参数；预期RC=1且报option '--help' doesn't allow an argument",
            "setup_commands": [
                "export LC_ALL='C'",
                "export LANG='C'"
            ],
            "args": ["--help=value"],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "whoami: option '--help' doesn't allow an argument\nTry 'whoami --help' for more information.\n"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "whoami",
            "description": "LC_ALL=C下空前缀长选项--=同时匹配help和version；预期RC=1并按GNU顺序列出两个歧义候选",
            "setup_commands": [
                "export LC_ALL='C'",
                "export LANG='C'"
            ],
            "args": ["--="],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "whoami: option '--=' is ambiguous; possibilities: '--help' '--version'\nTry 'whoami --help' for more information.\n"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "whoami",
            "description": "LC_ALL=C且未设置POSIXLY_CORRECT时，GNU标准选项扫描跨越首个操作数；operand后的未知选项优先报unrecognized option",
            "setup_commands": [
                "export LC_ALL='C'",
                "export LANG='C'",
                "unset POSIXLY_CORRECT"
            ],
            "args": ["operand", "--unknown"],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "whoami: unrecognized option '--unknown'\nTry 'whoami --help' for more information.\n"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "whoami",
            "description": "LC_ALL=C且POSIXLY_CORRECT=1时，首个操作数停止GNU标准选项扫描；后续--help仍是操作数，预期报首个extra operand",
            "setup_commands": [
                "export LC_ALL='C'",
                "export LANG='C'",
                "export POSIXLY_CORRECT=1"
            ],
            "args": ["operand", "--help"],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "whoami: extra operand 'operand'\nTry 'whoami --help' for more information.\n"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "byteMode": true,
            "command": "whoami",
            "description": "原始字节诊断用例：LC_ALL=C下传入未知长选项2d2dff，即--后跟单字节0xff；预期RC=1、stdout为空，stderr完整十六进制逐字节保留0xff，不经过UTF-8替换",
            "setup_commands": [
                "export LC_ALL='C'",
                "export LANG='C'"
            ],
            "args": ["2d2dff"],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "77686f616d693a20756e7265636f676e697a6564206f7074696f6e20272d2dff270a547279202777686f616d69202d2d68656c702720666f72206d6f726520696e666f726d6174696f6e2e0a"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "whoami",
            "description": "LC_ALL=C下stdout连接/dev/full；GNU close_stdout报告write error及ENOSPC文本，预期RC=1且stdout为空",
            "setup_commands": [
                "export LC_ALL='C'",
                "export LANG='C'"
            ],
            "args": [],
            "environment": {
                "standardStreams": {
                    "stdout": "full"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "whoami: write error: No space left on device\n"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "whoami",
            "description": "LC_ALL=C下启动前关闭stdout；GNU whoami保留关闭描述符的EBADF语义，预期RC=1且stderr为write error: Bad file descriptor",
            "setup_commands": [
                "export LC_ALL='C'",
                "export LANG='C'"
            ],
            "args": [],
            "environment": {
                "standardStreams": {
                    "stdout": "closed"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "whoami: write error: Bad file descriptor\n"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "whoami",
            "description": "LC_ALL=C下调用方忽略SIGPIPE且stdout连接无读端管道；GNU将EPIPE转换为write error: Broken pipe，预期RC=1",
            "setup_commands": [
                "export LC_ALL='C'",
                "export LANG='C'"
            ],
            "args": [],
            "environment": {
                "standardStreams": {
                    "stdout": "closed_pipe",
                    "sigpipe": "ignore",
                    "useBash": true
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "whoami: write error: Broken pipe\n"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "whoami",
            "description": "LC_ALL=C下调用方保留默认SIGPIPE且stdout连接无读端管道；GNU whoami在首次写入时被SIGPIPE终止，预期RC=141且无stdout和stderr",
            "setup_commands": [
                "export LC_ALL='C'",
                "export LANG='C'"
            ],
            "args": [],
            "environment": {
                "standardStreams": {
                    "stdout": "closed_pipe",
                    "sigpipe": "default",
                    "useBash": true
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 141,
                    "stdout": "",
                    "stderr": ""
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "whoami",
            "description": "LC_ALL=zh_CN.UTF-8下传入含双引号的操作数；GNU使用中文extra operand和try-help诊断，并以ASCII双引号转义操作数字节",
            "setup_commands": [
                "export LC_ALL='zh_CN.UTF-8'",
                "export LANG='zh_CN.UTF-8'"
            ],
            "args": ["a\"b"],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "whoami: 多余的操作对象 \"a\\\"b\"\n请尝试执行 \"whoami --help\" 来获取更多信息。\n"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "whoami",
            "description": "LC_ALL=zh_CN.UTF-8下stdout连接/dev/full；GNU将write error翻译为中文且保留ENOSPC文本",
            "setup_commands": [
                "export LC_ALL='zh_CN.UTF-8'",
                "export LANG='zh_CN.UTF-8'"
            ],
            "args": [],
            "environment": {
                "standardStreams": {
                    "stdout": "full"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "whoami: 写入错误: No space left on device\n"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "byteMode": true,
            "command": "whoami",
            "description": "原始字节诊断用例：LC_ALL=zh_CN.GBK下传入ASCII字节612262，即a双引号b；预期RC=1、stdout为空，stderr为GBK编码的GNU中文extra operand和try-help，其中操作数双引号转义为5c22",
            "setup_commands": [
                "export LC_ALL='zh_CN.GBK'",
                "export LANG='zh_CN.GBK'"
            ],
            "args": ["612262"],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "77686f616d693a20b6e0d3e0b5c4b2d9d7f7b6d4cff32022615c2262220ac7ebb3a2cad4d6b4d0d0202277686f616d69202d2d68656c702220c0b4bbf1c8a1b8fcb6e0d0c5cfa2a1a30a"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "byteMode": true,
            "command": "whoami",
            "description": "原始字节诊断用例：LC_ALL=zh_CN.GBK下传入GBK字节d6d0b9fa，即中国；预期RC=1、stdout为空，stderr中的操作数保留有效GBK多字节，不被UTF-8解析为八进制转义",
            "setup_commands": [
                "export LC_ALL='zh_CN.GBK'",
                "export LANG='zh_CN.GBK'"
            ],
            "args": ["d6d0b9fa"],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "77686f616d693a20b6e0d3e0b5c4b2d9d7f7b6d4cff32022d6d0b9fa220ac7ebb3a2cad4d6b4d0d0202277686f616d69202d2d68656c702220c0b4bbf1c8a1b8fcb6e0d0c5cfa2a1a30a"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "byteMode": true,
            "command": "whoami",
            "description": "原始字节诊断用例：LC_ALL=zh_CN.GBK下传入8140；0x40是GBK合法双字节字符的尾字节，预期RC=1、stdout为空，stderr中的操作数保留完整原始字节，不被拆成八进制转义和ASCII字符",
            "setup_commands": [
                "export LC_ALL='zh_CN.GBK'",
                "export LANG='zh_CN.GBK'"
            ],
            "args": ["8140"],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "77686f616d693a20b6e0d3e0b5c4b2d9d7f7b6d4cff320228140220ac7ebb3a2cad4d6b4d0d0202277686f616d69202d2d68656c702220c0b4bbf1c8a1b8fcb6e0d0c5cfa2a1a30a"
                }
            },
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "byteMode": true,
            "command": "whoami",
            "description": "原始字节诊断用例：LC_ALL=en_US默认使用ISO-8859-1，传入e9是有效单字节字符；预期RC=1、stdout为空，stderr中的操作数保留e9并使用GNU单引号，而非八进制转义",
            "setup_commands": [
                "export LC_ALL='en_US'",
                "export LANG='en_US'"
            ],
            "args": ["e9"],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "77686f616d693a206578747261206f706572616e642027e9270a547279202777686f616d69202d2d68656c702720666f72206d6f726520696e666f726d6174696f6e2e0a"
                }
            },
            "cleanup_commands": []
        }
    ]
}
