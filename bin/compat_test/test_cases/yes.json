{
    "tests": [
        {
            "tstdin": "",
            "command": "yes",
            "description": "基本功能测试",
            "args": [],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "y\ny\ny\ny\ny\ny\ny\ny\ny\ny\n",
                    "stderr": ""
                },
                "ignore_fields": {
                    "ignore_stdout": true
                }
            },
            "timeout": 1,
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "yes",
            "description": "指定输出字符串",
            "args": ["test"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "test\ntest\ntest\ntest\ntest\ntest\ntest\ntest\ntest\ntest\n",
                    "stderr": ""
                },
                "ignore_fields": {
                    "ignore_stdout": true
                }
            },
            "timeout": 1,
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "yes",
            "description": "指定多个参数",
            "args": ["hello", "world"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "hello world\nhello world\nhello world\nhello world\nhello world\nhello world\nhello world\nhello world\nhello world\nhello world\n",
                    "stderr": ""
                },
                "ignore_fields": {
                    "ignore_stdout": true
                }
            },
            "timeout": 1,
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "yes",
            "description": "LC_ALL=C下启动前stdout关闭时，GNU yes应以EBADF报告standard output并返回失败状态",
            "setup_commands": [
                "export LC_ALL='C'",
                "export LANG='C'"
            ],
            "args": ["x"],
            "environment": {
                "standardStreams": {
                    "stdout": "closed"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "yes: standard output: Bad file descriptor\n"
                }
            },
            "timeout": 1,
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "yes",
            "description": "LC_ALL=C下调用方忽略SIGPIPE且stdout为无读端管道时，GNU yes保留忽略处置并以EPIPE诊断退出",
            "setup_commands": [
                "export LC_ALL='C'",
                "export LANG='C'"
            ],
            "args": ["x"],
            "environment": {
                "standardStreams": {
                    "stdout": "closed_pipe",
                    "sigpipe": "ignore"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "yes: standard output: Broken pipe\n"
                }
            },
            "timeout": 1,
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "yes",
            "description": "LC_ALL=C下stdout为/dev/full时，GNU yes使用errno文本诊断空间不足而不附加Rust错误码",
            "setup_commands": [
                "export LC_ALL='C'",
                "export LANG='C'"
            ],
            "args": ["x"],
            "environment": {
                "standardStreams": {
                    "stdout": "full"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "yes: standard output: No space left on device\n"
                }
            },
            "timeout": 1,
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "yes",
            "description": "LC_ALL=C下stdout为写满的非阻塞管道时，GNU yes以EAGAIN报告standard output并立即失败",
            "setup_commands": [
                "export LC_ALL='C'",
                "export LANG='C'"
            ],
            "args": ["x"],
            "environment": {
                "standardStreams": {
                    "stdout": "nonblocking_full_pipe"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "yes: standard output: Resource temporarily unavailable\\n"
                }
            },
            "timeout": 1,
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "yes",
            "description": "POSIXLY_CORRECT下首个字符串后的--version是输出内容而不是版本选项",
            "args": ["alpha", "--version"],
            "environment": {
                "env_vars": {
                    "LC_ALL": "C",
                    "LANG": "C",
                    "POSIXLY_CORRECT": "1"
                },
                "standardStreams": {
                    "stdout": "null"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 137,
                    "stdout": "",
                    "stderr": ""
                }
            },
            "timeout": 1,
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "yes",
            "description": "LC_ALL=C下未知长选项使用GNU unrecognized option诊断",
            "setup_commands": [
                "export LC_ALL='C'",
                "export LANG='C'"
            ],
            "args": ["--unknown"],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "yes: unrecognized option '--unknown'\nTry 'yes --help' for more information.\n"
                }
            },
            "timeout": 1,
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "yes",
            "description": "LC_ALL=C下未知短选项使用GNU invalid option诊断",
            "setup_commands": [
                "export LC_ALL='C'",
                "export LANG='C'"
            ],
            "args": ["-x"],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "yes: invalid option -- 'x'\nTry 'yes --help' for more information.\n"
                }
            },
            "timeout": 1,
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "yes",
            "description": "LC_ALL=C下--help附带参数使用GNU不接收参数诊断",
            "setup_commands": [
                "export LC_ALL='C'",
                "export LANG='C'"
            ],
            "args": ["--help=x"],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "yes: option '--help' doesn't allow an argument\nTry 'yes --help' for more information.\n"
                }
            },
            "timeout": 1,
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "yes",
            "description": "LC_ALL=C下--version附带参数使用GNU不接收参数诊断",
            "setup_commands": [
                "export LC_ALL='C'",
                "export LANG='C'"
            ],
            "args": ["--version=x"],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "yes: option '--version' doesn't allow an argument\nTry 'yes --help' for more information.\n"
                }
            },
            "timeout": 1,
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "yes",
            "description": "LC_ALL=C下空前缀长选项--=按GNU规则列出help和version两个歧义候选",
            "setup_commands": [
                "export LC_ALL='C'",
                "export LANG='C'"
            ],
            "args": ["--="],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "yes: option '--=' is ambiguous; possibilities: '--help' '--version'\nTry 'yes --help' for more information.\n"
                }
            },
            "timeout": 1,
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "byteMode": true,
            "command": "yes",
            "description": "LC_ALL=C下非UTF-8未知长选项的诊断逐字节保留输入0xff",
            "setup_commands": [
                "export LC_ALL='C'",
                "export LANG='C'"
            ],
            "args": ["2d2dff"],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "7965733a20756e7265636f676e697a6564206f7074696f6e20272d2dff270a5472792027796573202d2d68656c702720666f72206d6f726520696e666f726d6174696f6e2e0a"
                }
            },
            "timeout": 1,
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "byteMode": true,
            "command": "yes",
            "description": "LC_ALL=C下非UTF-8未知短选项的诊断逐字节保留输入0xff",
            "setup_commands": [
                "export LC_ALL='C'",
                "export LANG='C'"
            ],
            "args": ["2dff"],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "7965733a20696e76616c6964206f7074696f6e202d2d2027ff270a5472792027796573202d2d68656c702720666f72206d6f726520696e666f726d6174696f6e2e0a"
                }
            },
            "timeout": 1,
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "byteMode": true,
            "command": "yes",
            "description": "LC_ALL=C下带非UTF-8值的空前缀长选项歧义诊断逐字节保留输入0xff",
            "setup_commands": [
                "export LC_ALL='C'",
                "export LANG='C'"
            ],
            "args": ["2d2d3dff"],
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "7965733a206f7074696f6e20272d2d3dff2720697320616d626967756f75733b20706f73736962696c69746965733a20272d2d68656c702720272d2d76657273696f6e270a5472792027796573202d2d68656c702720666f72206d6f726520696e666f726d6174696f6e2e0a"
                }
            },
            "timeout": 1,
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "byteMode": true,
            "command": "yes",
            "description": "LC_ALL=C下stdout为预填充后释放4096字节空间的非阻塞管道时，yes x写入2048行x\\n共4096字节后报告EAGAIN，新增字节通过GNU基线逐字节比较",
            "setup_commands": [
                "export LC_ALL='C'",
                "export LANG='C'"
            ],
            "args": ["78"],
            "environment": {
                "standardStreams": {
                    "stdout": "nonblocking_partial_pipe"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "7965733a207374616e64617264206f75747075743a205265736f757263652074656d706f726172696c7920756e617661696c61626c650a"
                }
            },
            "timeout": 1,
            "cleanup_commands": []
        }
    ]
}
