{
    "tests": [
        {
            "tstdin": "",
            "command": "yes",
            "description": "基本功能测试",
            "args": [],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "y\ny\ny\ny\ny\ny\ny\ny\ny\ny\n",
                    "stderr": ""
                },
                "ignore_fields": {
                    "ignore_stdout": true
                }
            },
            "timeout": 1,
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "yes",
            "description": "指定输出字符串",
            "args": ["test"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "test\ntest\ntest\ntest\ntest\ntest\ntest\ntest\ntest\ntest\n",
                    "stderr": ""
                },
                "ignore_fields": {
                    "ignore_stdout": true
                }
            },
            "timeout": 1,
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "yes",
            "description": "指定多个参数",
            "args": ["hello", "world"],
            "expectation": {
                "execution": {
                    "exit_code": 0,
                    "stdout": "hello world\nhello world\nhello world\nhello world\nhello world\nhello world\nhello world\nhello world\nhello world\nhello world\n",
                    "stderr": ""
                },
                "ignore_fields": {
                    "ignore_stdout": true
                }
            },
            "timeout": 1,
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "yes",
            "description": "LC_ALL=C下启动前stdout关闭时，GNU yes应以EBADF报告standard output并返回失败状态",
            "setup_commands": [
                "export LC_ALL='C'",
                "export LANG='C'"
            ],
            "args": ["x"],
            "environment": {
                "standardStreams": {
                    "stdout": "closed"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "yes: standard output: Bad file descriptor\n"
                }
            },
            "timeout": 1,
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "yes",
            "description": "LC_ALL=C下调用方忽略SIGPIPE且stdout为无读端管道时，GNU yes保留忽略处置并以EPIPE诊断退出",
            "setup_commands": [
                "export LC_ALL='C'",
                "export LANG='C'"
            ],
            "args": ["x"],
            "environment": {
                "standardStreams": {
                    "stdout": "closed_pipe",
                    "sigpipe": "ignore"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "yes: standard output: Broken pipe\n"
                }
            },
            "timeout": 1,
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "yes",
            "description": "LC_ALL=C下stdout为/dev/full时，GNU yes使用errno文本诊断空间不足而不附加Rust错误码",
            "setup_commands": [
                "export LC_ALL='C'",
                "export LANG='C'"
            ],
            "args": ["x"],
            "environment": {
                "standardStreams": {
                    "stdout": "full"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "yes: standard output: No space left on device\n"
                }
            },
            "timeout": 1,
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "yes",
            "description": "LC_ALL=C下stdout为写满的非阻塞管道时，GNU yes以EAGAIN报告standard output并立即失败",
            "setup_commands": [
                "export LC_ALL='C'",
                "export LANG='C'"
            ],
            "args": ["x"],
            "environment": {
                "standardStreams": {
                    "stdout": "nonblocking_full_pipe"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 1,
                    "stdout": "",
                    "stderr": "yes: standard output: Resource temporarily unavailable\\n"
                }
            },
            "timeout": 1,
            "cleanup_commands": []
        },
        {
            "tstdin": "",
            "command": "yes",
            "description": "POSIXLY_CORRECT下首个字符串后的--version是输出内容而不是版本选项",
            "args": ["alpha", "--version"],
            "environment": {
                "env_vars": {
                    "LC_ALL": "C",
                    "LANG": "C",
                    "POSIXLY_CORRECT": "1"
                },
                "standardStreams": {
                    "stdout": "null"
                }
            },
            "expectation": {
                "execution": {
                    "exit_code": 137,
                    "stdout": "",
                    "stderr": ""
                }
            },
            "timeout": 1,
            "cleanup_commands": []
        }
    ]
}
